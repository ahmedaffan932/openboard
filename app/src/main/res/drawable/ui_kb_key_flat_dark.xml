<?xml version="1.0" encoding="utf-8"?>
<!-- Key background, borderless themes (dark). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_active="true" android:state_pressed="true"
        android:drawable="@drawable/ui_kb_key_action_pressed" />
    <item android:state_active="true"
        android:drawable="@drawable/ui_kb_key_action_normal" />
    <item android:state_checkable="true" android:state_checked="true"
        android:drawable="@drawable/ui_kb_key_flat_checked_dark" />
    <item android:state_checkable="true" android:state_pressed="true"
        android:drawable="@drawable/ui_kb_key_flat_pressed_dark" />
    <item android:state_checkable="true"
        android:drawable="@android:color/transparent" />
    <item android:state_empty="true" android:state_pressed="true"
        android:drawable="@drawable/ui_kb_key_flat_pressed_dark" />
    <item android:state_empty="true"
        android:drawable="@android:color/transparent" />
    <item android:state_pressed="true"
        android:drawable="@drawable/ui_kb_key_flat_pressed_dark" />
    <item
        android:drawable="@android:color/transparent" />
</selector>
