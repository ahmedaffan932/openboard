<?xml version="1.0" encoding="utf-8"?>
<!-- Background of a full-row RadioButton inside a card: bg_ui_row_selected while checked. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/home_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:drawable="@drawable/bg_ui_row_selected" android:state_checked="true" />
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
