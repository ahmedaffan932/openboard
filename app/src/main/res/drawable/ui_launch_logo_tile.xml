<?xml version="1.0" encoding="utf-8"?>
<!-- Shadow outline behind the app logo on the exit screen (64dp). The radius matches the
     app_logo image corners (22.37%), so only the elevation shadow shows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/home_logo_end"
        android:startColor="@color/home_blue_start"
        android:type="linear" />
    <corners android:radius="14.3dp" />
</shape>
