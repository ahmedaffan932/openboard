<?xml version="1.0" encoding="utf-8"?><!--
    Window background of the "Add widget" card while cross-window blur is on (API 31+). The blur
    region follows this drawable's bounds and corner radius, so the dashboard is blurred only
    behind the card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_prompt_glass" />
    <corners android:radius="@dimen/widget_prompt_corner_radius" />
</shape>
