<?xml version="1.0" encoding="utf-8"?>
<!-- Action key (enter / go / search / send): the blue gradient of Figma "Keyboard · Translate Strip". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_kb_key_shadow_light" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/ui_kb_action_start"
                android:endColor="@color/ui_kb_action_end" android:type="linear" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
