<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard settings: back button (Figma: 40dp surface tile with the arrow). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="40dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_surface" />
            <stroke android:width="1dp" android:color="@color/home_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:width="20dp" android:height="20dp" android:gravity="center"
        android:drawable="@drawable/ic_ui_arrow_left" />
</layer-list>
