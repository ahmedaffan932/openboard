<?xml version="1.0" encoding="utf-8"?>
<!-- Conversation tab: language pill on the blue gradient card. White at 18% over the gradient,
     which is blue in light and dark mode alike, so it needs no theme token. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
