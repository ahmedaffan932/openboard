<?xml version="1.0" encoding="utf-8"?>
<!-- "Loading ad…" spinner (Figma 9:1869): an accent_soft track with an accent arc that fades into
     it, turning. ProgressBar drives the level, which only the rotate layer uses. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:innerRadiusRatio="2.5"
            android:shape="ring"
            android:thicknessRatio="10"
            android:useLevel="false">
            <solid android:color="@color/home_accent_soft" />
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="0"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="360">
            <shape
                android:innerRadiusRatio="2.5"
                android:shape="ring"
                android:thicknessRatio="10"
                android:useLevel="false">
                <gradient
                    android:endColor="@color/home_accent"
                    android:startColor="@color/home_accent_soft"
                    android:type="sweep"
                    android:useLevel="false" />
            </shape>
        </rotate>
    </item>
</layer-list>
