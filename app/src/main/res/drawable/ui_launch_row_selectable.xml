<?xml version="1.0" encoding="utf-8"?>
<!-- A row inside a card that shows the selected look (bg_ui_row_selected) while the row is
     setSelected(true), e.g. the chosen app language. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/home_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:drawable="@drawable/bg_ui_row_selected" android:state_selected="true" />
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
