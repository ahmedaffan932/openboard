<?xml version="1.0" encoding="utf-8"?><!--
    Glare across the lock-screen CTA (Figma "Lockscreen 1-3"). Always drawn over the gradient in
    lockscreen_cta_bg.xml, never on its own.

    Fitted to the frames rather than eyeballed: the streak is a 45 degree white band ("/") through
    the centre of the button whose opacity falls off as a gaussian - peak 0.67, sigma 10dp measured
    along x+y. The same band sits in the same place in all three frames, so it is part of the
    button, not of any one creative.

    The gradient axis runs (0,0) -> (187,187), so a stop's offset is (x+y)/374 across this
    330x44 viewport and the peak (x+y = 187) lands on the centre at offset 0.5. Every stop outside
    0.41..0.59 is transparent, which keeps all four corners empty: layer-list items are not
    clipped to the rounded rect underneath, so an opaque corner here would bleed past the radius.

    A vector, not a <shape><gradient>: shape gradients take three evenly spaced stops and an
    android:angle that runs corner to corner, which cannot draw a narrow band. The viewport is
    stretched to the real button; on screens wider than the 360dp frame the band leans a touch
    more, which is invisible on a glare.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="330dp"
    android:height="44dp"
    android:viewportWidth="330"
    android:viewportHeight="44">

    <path android:pathData="M0,0h330v44h-330z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="187"
                android:endY="187"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#00FFFFFF" android:offset="0" />
                <item android:color="#00FFFFFF" android:offset="0.4144" />
                <item android:color="#0AFFFFFF" android:offset="0.4358" />
                <item android:color="#17FFFFFF" android:offset="0.4465" />
                <item android:color="#2FFFFFFF" android:offset="0.4572" />
                <item android:color="#53FFFFFF" android:offset="0.4679" />
                <item android:color="#7CFFFFFF" android:offset="0.4786" />
                <item android:color="#9EFFFFFF" android:offset="0.4893" />
                <item android:color="#ABFFFFFF" android:offset="0.5" />
                <item android:color="#9EFFFFFF" android:offset="0.5107" />
                <item android:color="#7CFFFFFF" android:offset="0.5214" />
                <item android:color="#53FFFFFF" android:offset="0.5321" />
                <item android:color="#2FFFFFFF" android:offset="0.5428" />
                <item android:color="#17FFFFFF" android:offset="0.5535" />
                <item android:color="#0AFFFFFF" android:offset="0.5642" />
                <item android:color="#00FFFFFF" android:offset="0.5856" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
