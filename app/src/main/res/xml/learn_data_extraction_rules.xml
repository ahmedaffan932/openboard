<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer: only the Learn module's progress and
     settings. With <include> rules nothing else the app stores is copied. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="learn/" />
        <include domain="sharedpref" path="learn.xml" />
        <include domain="sharedpref" path="phrase_practice.xml" />
        <include domain="device_file" path="learn/" />
        <include domain="device_sharedpref" path="learn.xml" />
        <include domain="device_sharedpref" path="phrase_practice.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="learn/" />
        <include domain="sharedpref" path="learn.xml" />
        <include domain="sharedpref" path="phrase_practice.xml" />
        <include domain="device_file" path="learn/" />
        <include domain="device_sharedpref" path="learn.xml" />
        <include domain="device_sharedpref" path="phrase_practice.xml" />
    </device-transfer>
</data-extraction-rules>
