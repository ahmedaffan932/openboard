<?xml version="1.0" encoding="utf-8"?>
<!-- App-wide redesign styles (Figma TranslatorProZyro). Text styles extend HomeText (styles_home.xml).
     Colours come from colors_home.xml (values + values-night), so every screen gets dark mode. -->
<resources>
    <!-- Text -->
    <style name="HomeText.Display">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="HomeText.Screen">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="HomeText.CardLarge">
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="HomeText.Input">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="HomeText.BodyLarge">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="lineHeight">21sp</item>
    </style>

    <style name="HomeText.Body">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">18.5sp</item>
    </style>

    <style name="HomeText.BodyStrong">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">18.5sp</item>
    </style>

    <style name="HomeText.Small">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/home_text_secondary</item>
    </style>

    <style name="HomeText.Label">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="HomeText.LabelSmall">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HomeText.ButtonSmall">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/home_accent</item>
    </style>

    <style name="HomeText.Caption">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/home_text_secondary</item>
    </style>

    <style name="HomeText.CaptionMedium">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/home_text_muted</item>
    </style>

    <!-- Group label above a card ("Preferences", "Support"…). -->
    <style name="HomeText.GroupLabel">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/home_text_secondary</item>
    </style>

    <!-- Buttons: use on TextView / AppCompatButton, height 52dp in the layout. -->
    <style name="Widget.Ui.Button" parent="">
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Ui.Button.Primary">
        <item name="android:background">@drawable/bg_ui_button_primary</item>
        <item name="android:textColor">@color/home_on_accent</item>
        <item name="android:elevation">6dp</item>
        <item name="android:outlineSpotShadowColor">@color/home_shadow_blue</item>
        <item name="android:outlineAmbientShadowColor">@color/home_shadow_blue</item>
    </style>

    <style name="Widget.Ui.Button.Secondary">
        <item name="android:background">@drawable/bg_ui_button_secondary</item>
        <item name="android:textColor">@color/home_accent</item>
    </style>

    <style name="Widget.Ui.Button.Danger">
        <item name="android:background">@drawable/bg_ui_button_danger</item>
        <item name="android:textColor">@color/home_on_accent</item>
    </style>

    <style name="Widget.Ui.Button.Pro">
        <item name="android:background">@drawable/bg_ui_button_pro</item>
        <item name="android:textColor">@color/home_on_accent</item>
        <item name="android:elevation">6dp</item>
        <item name="android:outlineSpotShadowColor">@color/home_shadow_pro</item>
        <item name="android:outlineAmbientShadowColor">@color/home_shadow_pro</item>
    </style>

    <!-- 36dp square icon button (back, settings, header actions). Set app:srcCompat + app:tint. -->
    <style name="Widget.Ui.IconButton" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_home_icon_button</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/home_text_secondary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- Switch / radio -->
    <style name="Widget.Ui.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/ui_switch_thumb</item>
        <item name="thumbTint">@null</item>
        <item name="track">@drawable/ui_switch_track</item>
        <item name="trackTint">@null</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">26dp</item>
        <item name="android:background">@null</item>
        <item name="switchMinWidth">44dp</item>
    </style>

    <style name="Widget.Ui.Radio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@drawable/ui_radio</item>
        <item name="buttonTint">@null</item>
        <item name="android:background">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Horizontal progress bar -->
    <style name="Widget.Ui.Progress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/ui_progress_horizontal</item>
        <item name="android:minHeight">8dp</item>
        <item name="android:maxHeight">8dp</item>
    </style>
</resources>
