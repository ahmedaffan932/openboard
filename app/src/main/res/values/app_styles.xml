<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dashboard bottom navigation labels: Manrope SemiBold 10 (Figma "Home — Redesign"). -->
    <style name="TextAppearanceAppBottomNavigationActive">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineHeight">13sp</item>
    </style>

    <style name="TextAppearanceAppBottomNavigationInactive" parent="TextAppearanceAppBottomNavigationActive" />

    <!-- The 40x30 pill behind the selected tab's icon. -->
    <style name="Widget.App.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:width">40dp</item>
        <item name="android:height">30dp</item>
        <item name="android:color">@color/home_accent_soft</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="ShapeAppearance.App.BottomNavigation.ActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
