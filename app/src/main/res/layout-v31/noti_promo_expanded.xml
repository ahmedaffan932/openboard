<?xml version="1.0" encoding="utf-8"?><!--
    Expanded Kill-App, Clicked-Ads and Win-Back notifications, API 31+. Same card as
    layout/noti_promo_expanded.xml (read its notes) except the photo: android:clipToOutline is an
    XML attribute from API 31, so here the unrounded art is clipped to noti_promo_hero_frame and
    may centerCrop - full width, a sliver lost top and bottom when the height cap bites.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvNotiTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/home_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNotiDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/home_text_secondary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/ivNotiHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:background="@drawable/noti_promo_hero_frame"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:maxHeight="@dimen/noti_promo_hero_max_height"
        android:scaleType="centerCrop" />

    <!-- Figma 11:2354: a right-aligned "Try now" pill under the photo. -->
    <TextView
        android:id="@+id/btnNotiCta"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:background="@drawable/ui_sys_noti_cta"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="96dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/home_on_accent"
        android:textSize="14sp" />

</LinearLayout>
