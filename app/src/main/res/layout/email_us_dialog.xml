<?xml version="1.0" encoding="utf-8"?>
<!-- Feedback sheet (classes/EmailUsDialogBox, opened from Settings). Figma: TranslatorProZyro,
     feedback (9:1644). SettingsActivity makes the window full width with a transparent background and
     EmailUsDialogBox pins it to the bottom, so this root is the sheet. Ids and classes are bound by
     SettingsActivity: btnClose (ImageView), etTopic, etFeedbackBody (EditText),
     btnPublishFeedback (ConstraintLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ui_sheet"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_ui_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_ui_tile_accent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_ui_message"
                app:tint="@color/home_accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/textView6"
            style="@style/HomeText.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/feedback" />

        <ImageView
            android:id="@+id/btnClose"
            style="@style/Widget.Ui.IconButton"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/close"
            app:srcCompat="@drawable/ic_ui_x" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView5"
        style="@style/HomeText.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ui_sys_feedback_body" />

    <EditText
        android:id="@+id/etTopic"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_ui_input"
        android:fontFamily="@font/manrope_medium"
        android:hint="@string/enter_topic_here"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/home_text_primary"
        android:textColorHint="@color/home_hint"
        android:textCursorDrawable="@drawable/cursor_home"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etFeedbackBody"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_ui_input"
        android:fontFamily="@font/manrope_medium"
        android:gravity="top|start"
        android:hint="@string/write_your_suggestion"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="14dp"
        android:scrollbars="vertical"
        android:textColor="@color/home_text_primary"
        android:textColorHint="@color/home_hint"
        android:textCursorDrawable="@drawable/cursor_home"
        android:textSize="14sp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnPublishFeedback"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_ui_button_primary"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:outlineAmbientShadowColor="@color/home_shadow_blue"
        android:outlineSpotShadowColor="@color/home_shadow_blue"
        tools:targetApi="p">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_bold"
            android:includeFontPadding="false"
            android:text="@string/ui_sys_send_feedback"
            android:textColor="@color/home_on_accent"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
