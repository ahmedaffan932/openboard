<?xml version="1.0" encoding="utf-8"?>
<!-- A selectable row (Figma "Learn · Choose language", "Daily goal", "Switch course"): leading flag or
     icon, title with optional badge, subtitle, radio. LearnUi.bindOption sets the selected look. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_ui_card_r16_clickable"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:outlineSpotShadowColor="@color/home_shadow"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    tools:targetApi="p">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivFlag"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/roundedCorners" />

    <FrameLayout
        android:id="@+id/flIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_ui_tile_accent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/home_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/HomeText.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Spanish" />

            <TextView
                android:id="@+id/tvBadge"
                style="@style/HomeText.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_learn_chip_orange"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/home_orange"
                android:visibility="gone"
                tools:text="Popular"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/HomeText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Beginner · 12 units" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivRadio"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ui_radio_off" />
</LinearLayout>
