<?xml version="1.0" encoding="utf-8"?>
<!-- Phrasebook category card (Figma 5:759): tone icon tile + name. PhraseBookMainAdapter sets the
     icon, its tile and tint per category. The 5dp padding makes the 10dp gaps of the grid; the card
     takes the row's full height so both cards of a row line up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/cl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_ui_card_r16_clickable"
        android:clickable="true"
        android:elevation="2dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:outlineSpotShadowColor="@color/home_shadow"
        android:padding="12dp"
        tools:targetApi="p">

        <FrameLayout
            android:id="@+id/flPhraseMainItemIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_ui_tile_orange">

            <ImageView
                android:id="@+id/imgPhraseMainItemIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_ui_cart" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPhraseBookMainItem"
            style="@style/HomeText.TileTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            tools:text="At the Store" />

        <!-- Kept for the adapter; the redesign has no trailing chevron. -->
        <ImageView
            android:id="@+id/btnItemNext"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/nativeAdFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
