<?xml version="1.0" encoding="utf-8"?>
<!-- Language selector. Figma: TranslatorProZyro "Translate to" (6:816), downloading state (20:4940).
     "Recently used" and "All languages" groups, each a card of languages_list rows. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    tools:context="org.dslul.openboard.translator.pro.LanguageSelectorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/llCollapsibleBanner"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header: back + "Translate to" / "Translate from" (set in code). -->
        <LinearLayout
            android:id="@+id/llTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btnBack"
                style="@style/Widget.Ui.IconButton"
                android:contentDescription="@string/ui_tr_back"
                android:outlineSpotShadowColor="@color/home_shadow"
                app:srcCompat="@drawable/ic_ui_arrow_left"
                app:tint="@color/home_text_primary"
                tools:targetApi="p" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/HomeText.Screen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                tools:text="@string/ui_tr_translate_to" />
        </LinearLayout>

        <!-- From / To tabs: hidden, the code still updates them. -->
        <LinearLayout
            android:id="@+id/ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ui_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLanguageFrom"
                style="@style/HomeText.Language"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_row_selected"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/english" />

            <TextView
                android:id="@+id/tvLanguageTo"
                style="@style/HomeText.Language"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_row_selected"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/textView" />
        </LinearLayout>

        <!-- Search: hidden, as before (the code never shows it). -->
        <SearchView
            android:id="@+id/simpleSearchView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ui_search"
            android:iconifiedByDefault="false"
            android:queryBackground="@android:color/transparent"
            android:queryHint="Search Language"
            android:theme="@style/EditTextTheme"
            android:visibility="gone"
            tools:ignore="RtlSymmetry" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/textViewRecentlyUsedLng"
                style="@style/HomeText.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="4dp"
                android:paddingBottom="8dp"
                android:text="@string/recently_used"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRecentLanguages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:nestedScrollingEnabled="false"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:overScrollMode="never"
                android:padding="4dp"
                tools:itemCount="2"
                tools:listitem="@layout/languages_list"
                tools:targetApi="p" />

            <TextView
                android:id="@+id/textView2"
                style="@style/HomeText.GroupLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="4dp"
                android:paddingBottom="8dp"
                android:text="@string/all_languages" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewLanguages"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:overScrollMode="never"
                android:padding="4dp"
                android:scrollbars="none"
                tools:listitem="@layout/languages_list"
                tools:targetApi="p" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDisableTouch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/llCollapsibleBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
