<?xml version="1.0" encoding="utf-8"?>
<!-- Learning settings (Figma "Learn · Settings"): course, daily goal, reminder, listening, vibration,
     reset, about. Rows are item_learn_setting_row includes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    tools:context=".learn.LearnSettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Ui.IconButton"
            android:contentDescription="@string/ui_tr_back"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:srcCompat="@drawable/ic_ui_arrow_left"
            app:tint="@color/home_text_primary"
            tools:targetApi="p" />

        <TextView
            style="@style/HomeText.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/learn_settings_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/HomeText.GroupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/learn_group_course" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:padding="2dp"
                tools:targetApi="p">

                <include android:id="@+id/rowCourse" layout="@layout/item_learn_setting_row" />

                <View style="@style/LearnDivider" />

                <include android:id="@+id/rowGoal" layout="@layout/item_learn_setting_row" />
            </LinearLayout>

            <TextView
                style="@style/HomeText.GroupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/learn_group_reminders" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:padding="2dp"
                tools:targetApi="p">

                <include android:id="@+id/rowReminder" layout="@layout/item_learn_setting_row" />

                <View style="@style/LearnDivider" />

                <include android:id="@+id/rowReminderTime" layout="@layout/item_learn_setting_row" />
            </LinearLayout>

            <TextView
                style="@style/HomeText.GroupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/learn_group_lessons" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:padding="2dp"
                tools:targetApi="p">

                <include android:id="@+id/rowListening" layout="@layout/item_learn_setting_row" />

                <View style="@style/LearnDivider" />

                <include android:id="@+id/rowVibration" layout="@layout/item_learn_setting_row" />
            </LinearLayout>

            <TextView
                style="@style/HomeText.GroupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/learn_group_data" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:padding="2dp"
                tools:targetApi="p">

                <include android:id="@+id/rowReset" layout="@layout/item_learn_setting_row" />

                <View style="@style/LearnDivider" />

                <include android:id="@+id/rowAbout" layout="@layout/item_learn_setting_row" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
