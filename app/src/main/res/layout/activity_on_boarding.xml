<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding. Figma TranslatorProZyro "Onboarding 1-3" (4:262, 4:361, 4:429): pages
     (fragment_splash) with Skip on top, page dots, a full-width Next / Get started button and a
     small native ad at the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/home_bg"
    tools:context="org.dslul.openboard.translator.pro.OnBoardingActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/splashViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/llDots"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnContinue"
        style="@style/HomeText.LabelSmall"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ui_launch_skip_pill"
        android:elevation="1dp"
        android:gravity="center"
        android:minWidth="56dp"
        android:outlineSpotShadowColor="@color/home_shadow"
        android:paddingHorizontal="14dp"
        android:text="@string/ui_launch_skip"
        android:textColor="@color/home_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:targetApi="p" />

    <!-- Page dots: OnBoardingActivity widens the current one (22x6) and tints it. -->
    <LinearLayout
        android:id="@+id/llDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="22dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="22dp"
            android:layout_height="6dp"
            android:background="@drawable/ui_launch_dot_active" />

        <View
            android:id="@+id/dot2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/ui_launch_dot_inactive" />

        <View
            android:id="@+id/dot3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/ui_launch_dot_inactive" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnNext"
        style="@style/Widget.Ui.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/next"
        app:layout_constraintBottom_toTopOf="@id/llCollapsibleBanner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/llCollapsibleBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/nativeAdFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
