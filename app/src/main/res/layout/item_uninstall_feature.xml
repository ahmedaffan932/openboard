<?xml version="1.0" encoding="utf-8"?>
<!-- A feature tile on the uninstall survey (icon tile + label). UninstallSurveyActivity sets the
     icon, its tone (tile background + tint) and the label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ui_card_r16"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:outlineSpotShadowColor="@color/home_shadow"
    android:padding="11dp"
    tools:targetApi="p">

    <FrameLayout
        android:id="@+id/featureTile"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_ui_tile_accent">

        <ImageView
            android:id="@+id/imgFeature"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_ui_camera"
            app:tint="@color/home_accent" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvFeature"
        style="@style/HomeText.BodyStrong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:maxLines="2"
        android:text="@string/uninstall_feature_camera"
        android:textSize="13sp" />

</LinearLayout>
