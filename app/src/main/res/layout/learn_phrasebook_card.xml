<?xml version="1.0" encoding="utf-8"?>
<!-- Phrasebook tab "Practice phrases" card (Figma "Phrasebook · Practice entry"). Opens Phrase Practice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llPracticePhrases"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_ui_card_clickable"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineSpotShadowColor="@color/home_shadow"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    tools:targetApi="p">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_ui_tile_purple">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_ui_shuffle"
            app:tint="@color/home_purple" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/HomeText.CardLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/learn_practice_phrases" />

        <TextView
            style="@style/HomeText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/learn_practice_phrases_desc" />
    </LinearLayout>

    <TextView
        style="@style/Widget.Ui.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:clickable="false"
        android:focusable="false"
        android:minHeight="34dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/learn_card_start"
        android:textSize="13sp"
        tools:targetApi="p" />
</LinearLayout>
