<?xml version="1.0" encoding="utf-8"?>
<!-- Learn dialogs (Figma "Learn · Unit locked", "Lesson · Quit"): icon circle, title, message,
     primary button, optional second filled button (Go Pro), text button. Filled in LearnUi.messageDialog. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ui_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/flIcon"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_ui_circle_orange">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_ui_lock" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            style="@style/HomeText.Screen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            tools:text="Unit 4 is locked" />

        <TextView
            android:id="@+id/tvMessage"
            style="@style/HomeText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/home_text_secondary"
            tools:text="Units 1–3 are free." />

        <TextView
            android:id="@+id/btnPrimary"
            style="@style/Widget.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            tools:targetApi="p"
            tools:text="Watch ad · unlock 24h" />

        <TextView
            android:id="@+id/btnExtra"
            style="@style/Widget.Ui.Button.Pro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            tools:targetApi="p"
            tools:text="Go Pro · all units" />

        <TextView
            android:id="@+id/btnSecondary"
            style="@style/HomeText.Label"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_ui_row_ripple"
            android:gravity="center"
            android:textColor="@color/home_text_secondary"
            android:textSize="15sp"
            tools:text="Not now" />
    </LinearLayout>
</FrameLayout>
