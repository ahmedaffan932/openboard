<?xml version="1.0" encoding="utf-8"?>
<!-- Large native ad, default large remote variant (AdmobNativeAds.chooseLayout; the slot is 300dp
     tall). Figma: TranslatorProZyro "Native Ad/Large" (3:165): icon, headline, rating / "Sponsored",
     AD badge; two lines of body; rounded media frame taking the rest; full-width gradient CTA.
     AdChoices sits top-left, over the card's padding. -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ui_card"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/HomeAdIconShape" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope_bold"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    tools:text="WordUp: Vocabulary Builder" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ad_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:fontFamily="@font/manrope_bold"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="★ 4.6"
                        tools:visibility="visible" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_medium"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/ui_sys_ad_sponsored"
                        android:textColor="@color/home_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_ad_badge"
                android:fontFamily="@font/manrope_extrabold"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/ad_label"
                android:textAllCaps="true"
                android:textColor="@color/home_ad_badge_text"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_regular"
            android:lineSpacingExtra="2sp"
            android:maxLines="2"
            android:textColor="@color/home_text_secondary"
            android:textSize="12sp"
            tools:text="Learn 10 new words a day with quick quizzes and smart reminders." />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/ui_sys_ad_media"
            android:clipToOutline="true"
            tools:targetApi="s">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ui_button_primary"
            android:elevation="4dp"
            android:fontFamily="@font/manrope_bold"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:outlineAmbientShadowColor="@color/home_shadow_blue"
            android:outlineSpotShadowColor="@color/home_shadow_blue"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="@string/install"
            android:textAllCaps="false"
            android:textColor="@color/home_on_accent"
            android:textSize="15sp"
            tools:targetApi="p" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
