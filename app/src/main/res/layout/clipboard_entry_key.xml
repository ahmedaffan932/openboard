<?xml version="1.0" encoding="utf-8"?>
<!-- One clip card on the keyboard's clipboard panel: the clip with a send button, then its
     translation (or a shimmer while it loads). Colours here are the light keyboard's; ClipboardAdapter
     recolours them from the keyboard theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="@dimen/padding"
    android:paddingStart="@dimen/less_padding"
    android:layout_margin="@dimen/less_padding"
    android:paddingVertical="@dimen/less_padding"
    android:background="@color/color_nothing"
    android:animateLayoutChanges="true"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/clipboard_entry_pinned_icon"
        android:layout_width="@dimen/config_clipboard_pinned_icon_size"
        android:layout_height="@dimen/config_clipboard_pinned_icon_size"
        android:src="@drawable/ic_outline_push_pin_24"
        android:paddingHorizontal="@dimen/less_padding" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_clipboard_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nothing_ripple_padding_rounded"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/copied_text"
                android:id="@+id/clipboard_entry_caption"
                android:textColor="@color/ui_kb_text_secondary_light"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/clipboard_entry_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:hapticFeedbackEnabled="false"
                    android:maxLines="4"
                    android:soundEffectsEnabled="false"
                    android:text="@string/app_name"
                    android:textColor="@color/ui_kb_text_light" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_nothing_ripple_padding_rounded"
                    android:padding="@dimen/less_padding"
                    android:id="@+id/clipboard_entry_send"
                    android:tint="@color/ui_kb_accent_light"
                    android:src="@drawable/ic_send_clipboard_text" />

            </LinearLayout>

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/padding"
            android:id="@+id/clipboard_entry_divider"
            android:background="@color/ui_kb_divider_light" />

        <LinearLayout
            android:id="@+id/llTranslatedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding"
            android:background="@drawable/bg_nothing_ripple_padding_rounded"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textLngFrom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/english"
                    android:textColor="@color/ui_kb_text_secondary_light"
                    android:textSize="11sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="@dimen/less_padding"
                    android:src="@drawable/ic_baseline_navigate_next_24"
                    android:id="@+id/clipboard_entry_arrow"
                    app:tint="@color/ui_kb_accent_light" />

                <TextView
                    android:id="@+id/textLngTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/english"
                    android:textColor="@color/ui_kb_text_secondary_light"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/clipboard_translated_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:hapticFeedbackEnabled="false"
                    android:maxLines="4"
                    android:layout_weight="1"
                    android:soundEffectsEnabled="false"
                    android:textColor="@color/ui_kb_text_light" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_nothing_ripple_padding_rounded"
                    android:id="@+id/clipboard_translated_send"
                    android:tint="@color/ui_kb_accent_light"
                    android:padding="@dimen/less_padding"
                    android:src="@drawable/ic_send_clipboard_text" />
            </LinearLayout>
        </LinearLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding"
            app:shimmer_auto_start="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/english"
                        android:textColor="@color/ui_kb_shimmer"
                        android:background="@color/ui_kb_shimmer"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginHorizontal="@dimen/padding"
                        android:src="@drawable/ic_baseline_navigate_next_24"
                        app:tint="@color/ui_kb_shimmer" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/english"
                        android:background="@color/ui_kb_shimmer"
                        android:textColor="@color/ui_kb_shimmer"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:background="@color/ui_kb_shimmer"
                        android:hapticFeedbackEnabled="false"
                        android:maxLines="4"
                        android:layout_weight="1"
                        android:soundEffectsEnabled="false"
                        android:textColor="@color/ui_kb_shimmer" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_nothing_ripple_padding_rounded"
                        android:tint="@color/ui_kb_shimmer"
                        android:padding="@dimen/less_padding"
                        android:src="@drawable/ic_send_clipboard_text" />
                </LinearLayout>
            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>


    </LinearLayout>


</LinearLayout>
