<?xml version="1.0" encoding="utf-8"?>
<!-- Scan result (OCR). Figma: TranslatorProZyro "Scan result" (7:1406), detecting state (21:5366).
     The photo sits in a rounded viewfinder card with the language bar on top; the result rows are in
     the bottom sheet (bottom_sheet_ocr_translation_result.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/OCRActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    tools:context="org.dslul.openboard.translator.pro.OCRActivity">

    <!-- Header: back + title. -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Ui.IconButton"
            android:contentDescription="@string/ui_tr_back"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:srcCompat="@drawable/ic_ui_arrow_left"
            app:tint="@color/home_text_primary"
            tools:targetApi="p" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/HomeText.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/ui_tr_scan_result" />
    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clAdsBottom"
        app:layout_constraintTop_toBottomOf="@id/llTopBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Rounded viewfinder card: the photo with its text boxes, language bar on top. -->
            <!-- OCRActivity clips this card to its rounded outline. -->
            <FrameLayout
                android:id="@+id/cvViewfinder"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_ui_viewfinder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imageViewOcr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:paddingTop="68dp"
                    android:paddingBottom="96dp"
                    android:scaleType="fitCenter" />

                <!-- Language bar card. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llLanguageSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_ui_card_r16"
                    android:elevation="4dp"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    android:padding="6dp"
                    android:transitionName="anim_ll_languages"
                    tools:targetApi="p">

                    <LinearLayout
                        android:id="@+id/llLanguageFrom"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_home_lang_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toStartOf="@id/ivSwitchLanguages"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/flagFrom"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/us_flag"
                            app:shapeAppearanceOverlay="@style/roundedCorners" />

                        <TextView
                            android:id="@+id/tvLanguageFrom"
                            style="@style/HomeText.Language"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/english" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_chevron_down" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivSwitchLanguages"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_home_swap"
                        android:contentDescription="@string/swap_languages"
                        android:padding="10.5dp"
                        android:src="@drawable/ic_home_swap"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/llLanguageTo"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_home_lang_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toEndOf="@id/ivSwitchLanguages"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_chevron_down" />

                        <TextView
                            android:id="@+id/tvLanguageTo"
                            style="@style/HomeText.Language"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            tools:text="English" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/flagTo"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/by_flag"
                            app:shapeAppearanceOverlay="@style/roundedCorners" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- "Detecting text…" / "Translating…" card; the full-size layer blocks taps meanwhile. -->
            <LinearLayout
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="208dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ui_dialog"
                    android:elevation="8dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="22dp"
                    tools:targetApi="p">

                    <ProgressBar
                        style="?android:attr/progressBarStyle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:indeterminateTint="@color/home_accent" />

                    <TextView
                        android:id="@+id/pbText"
                        style="@style/HomeText.BodyStrong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/ui_tr_detecting_text" />

                    <ProgressBar
                        style="@style/Widget.Ui.Progress"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="14dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/home_accent"
                        android:minHeight="6dp"
                        android:maxHeight="6dp" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
            android:id="@+id/bottomSheetResult"
            layout="@layout/bottom_sheet_ocr_translation_result" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAdsBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/frameLayoutBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/home_surface"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
