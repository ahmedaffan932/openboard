<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_screen"
    tools:context="org.dslul.openboard.translator.pro.AppLanguageSelectorActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_bar"
        android:elevation="@dimen/padding"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/fab_padding"
            android:layout_marginTop="@dimen/extra_padding"
            android:layout_marginBottom="@dimen/fab_padding"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="@dimen/padding"
            android:text="@string/select_app_language"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginVertical="@dimen/less_padding"
            android:layout_marginEnd="@dimen/m_padding"
            android:background="@drawable/bg_language_next_button"
            android:drawableEnd="@drawable/ic_language_next_arrow"
            android:drawablePadding="@dimen/less_padding"
            android:elevation="@dimen/less_padding"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/padding_10"
            android:paddingEnd="@dimen/padding"
            android:singleLine="true"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/nativeAdFrameLayout"
        app:layout_constraintTop_toBottomOf="@id/clTopBar">

        <in.daemondhruv.customviewgroup.ConstraintRadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent">

            <RadioButton
                android:id="@+id/rbEnglish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="en"
                android:text="@string/app_language_english"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/us_flag"
                app:layout_constraintBottom_toBottomOf="@id/rbEnglish"
                app:layout_constraintStart_toStartOf="@id/rbEnglish"
                app:layout_constraintTop_toTopOf="@id/rbEnglish"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <RadioButton
                android:id="@+id/rbFrench"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:layout_marginBottom="@dimen/less_padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="fr"
                android:text="@string/app_language_french"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rbEnglish" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/fr"
                app:layout_constraintBottom_toBottomOf="@id/rbFrench"
                app:layout_constraintStart_toStartOf="@id/rbFrench"
                app:layout_constraintTop_toTopOf="@id/rbFrench"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <RadioButton
                android:id="@+id/rbGerman"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:layout_marginBottom="@dimen/less_padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="de"
                android:text="@string/app_language_german"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rbFrench" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/de"
                app:layout_constraintBottom_toBottomOf="@id/rbGerman"
                app:layout_constraintStart_toStartOf="@id/rbGerman"
                app:layout_constraintTop_toTopOf="@id/rbGerman"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <RadioButton
                android:id="@+id/rbSpanish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="es"
                android:text="@string/app_language_spanish"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rbGerman" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/es"
                app:layout_constraintBottom_toBottomOf="@id/rbSpanish"
                app:layout_constraintStart_toStartOf="@id/rbSpanish"
                app:layout_constraintTop_toTopOf="@id/rbSpanish"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <RadioButton
                android:id="@+id/rbHindi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:layout_marginBottom="@dimen/less_padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="hi"
                android:text="@string/app_language_hindi"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rbSpanish" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/in"
                app:layout_constraintBottom_toBottomOf="@id/rbHindi"
                app:layout_constraintStart_toStartOf="@id/rbHindi"
                app:layout_constraintTop_toTopOf="@id/rbHindi"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <RadioButton
                android:id="@+id/rbPortuguese"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:layout_marginBottom="@dimen/less_padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="pt"
                android:text="@string/app_language_portuguese"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rbHindi" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/pt"
                app:layout_constraintBottom_toBottomOf="@id/rbPortuguese"
                app:layout_constraintStart_toStartOf="@id/rbPortuguese"
                app:layout_constraintTop_toTopOf="@id/rbPortuguese"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <RadioButton
                android:id="@+id/rbKorean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:layout_marginBottom="@dimen/less_padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="ko"
                android:text="@string/app_language_korean"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rbPortuguese" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/kr_flag"
                app:layout_constraintBottom_toBottomOf="@id/rbKorean"
                app:layout_constraintStart_toStartOf="@id/rbKorean"
                app:layout_constraintTop_toTopOf="@id/rbKorean"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <RadioButton
                android:id="@+id/rbItalian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:layout_marginBottom="@dimen/less_padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="it"
                android:text="@string/app_language_italian"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rbKorean" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/it"
                app:layout_constraintBottom_toBottomOf="@id/rbItalian"
                app:layout_constraintStart_toStartOf="@id/rbItalian"
                app:layout_constraintTop_toTopOf="@id/rbItalian"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <RadioButton
                android:id="@+id/rbRussian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginHorizontal="@dimen/m_padding"
                android:layout_marginTop="@dimen/padding"
                android:layout_marginBottom="@dimen/less_padding"
                android:background="@drawable/bg_main_less_rounded"
                android:backgroundTint="@color/white"
                android:button="@null"
                android:buttonTint="@color/blue"
                android:drawableRight="?android:attr/listChoiceIndicatorSingle"
                android:drawableTint="@color/blue"
                android:elevation="1dp"
                android:paddingVertical="@dimen/padding_10"
                android:paddingLeft="56dp"
                android:tag="ru"
                android:text="@string/app_language_russian"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rbItalian" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/padding"
                android:elevation="@dimen/less_padding"
                android:scaleType="fitXY"
                android:src="@drawable/ru"
                app:layout_constraintBottom_toBottomOf="@id/rbRussian"
                app:layout_constraintStart_toStartOf="@id/rbRussian"
                app:layout_constraintTop_toTopOf="@id/rbRussian"
                app:shapeAppearanceOverlay="@style/roundedCorners" />


        </in.daemondhruv.customviewgroup.ConstraintRadioGroup>

    </ScrollView>

    <FrameLayout
        android:id="@+id/nativeAdFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
