<?xml version="1.0" encoding="utf-8"?>
<!-- App language. Figma TranslatorProZyro "App Language" (4:79): title + gradient Next pill,
     subtitle, the languages as rows in one card (selected row tinted), native ad at the bottom.
     Each RadioButton sits inside its row; ConstraintRadioGroup finds nested RadioButtons, and
     AppLanguageSelectorActivity checks a row's radio when the row is tapped. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    tools:context="org.dslul.openboard.translator.pro.AppLanguageSelectorActivity">

    <LinearLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            style="@style/HomeText.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_app_language" />

        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_ui_button_primary"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/home_shadow_blue"
            android:outlineSpotShadowColor="@color/home_shadow_blue"
            android:paddingStart="18dp"
            android:paddingEnd="14dp"
            android:visibility="invisible"
            tools:targetApi="p"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/next"
                android:textColor="@color/home_on_accent"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_ui_arrow_right"
                app:tint="@color/home_on_accent" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/HomeText.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:text="@string/ui_launch_lang_subtitle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <in.daemondhruv.customviewgroup.ConstraintRadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/llLanguages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:padding="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:targetApi="p">

                <LinearLayout
                    android:id="@+id/rowEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ui_launch_row_selectable"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/us_flag"
                        app:shapeAppearanceOverlay="@style/roundedCorners" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_language_english"
                            android:textColor="@color/ui_launch_text_selected" />

                        <TextView
                            style="@style/HomeText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ui_launch_lang_english" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rbEnglish"
                        style="@style/Widget.Ui.Radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:tag="en"
                        app:buttonCompat="@drawable/ui_radio" />
                </LinearLayout>

