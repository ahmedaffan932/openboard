                        android:orientation="vertical">

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_language_portuguese"
                            android:textColor="@color/ui_launch_text_selected" />

                        <TextView
                            style="@style/HomeText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ui_launch_lang_portuguese" />
