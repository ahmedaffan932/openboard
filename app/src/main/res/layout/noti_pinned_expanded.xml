<?xml version="1.0" encoding="utf-8"?><!--
    Expanded pinned notification. Figma: TranslatorProZyro, notifications (11:2354) "Quick Access":
    "Translate in one tap!", one line of copy, then four tools - Translate, Voice, Camera, File - each
    a 48dp soft-tone tile with a tinted glyph and the label under it, opening its tool through
    QuickAccessActivity. Android draws the header ("<app> • Quick Access") and the card.

    The columns share the width (~65dp each in the ~260dp column of API 31+); a long label shrinks
    to fit (UiSysNotiTileLabel). The tap target is the whole column (the ids), with a ripple masked
    to the tile's corners.

    Inflated by SystemUI: framework views and attributes only, system fonts only, no ?attr, no app:tint.
    Texts are set from code in the app's own language (a @string here would follow the system's).
    Colours are home_* tokens, which SystemUI resolves for the system's day/night; the glyphs are
    ic_ui_* vectors recoloured with the framework android:tint.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="UseAppTint">

    <TextView
        android:id="@+id/tvNotiTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/home_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Translate in one tap!" />

    <TextView
        android:id="@+id/tvNotiDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/home_text_secondary"
        android:textSize="13sp"
        tools:text="Pick a tool and go." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/pinTileTranslate"
            style="@style/UiSysNotiTile">

            <ImageView
                style="@style/UiSysNotiTileIcon"
                android:background="@drawable/ui_sys_noti_tile_accent"
                android:src="@drawable/ic_ui_languages"
                android:tint="@color/home_accent" />

            <TextView
                android:id="@+id/pinLabelTranslate"
                style="@style/UiSysNotiTileLabel"
                tools:text="Translate" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinTileVoice"
            style="@style/UiSysNotiTile"
            android:layout_marginStart="6dp">

            <ImageView
                style="@style/UiSysNotiTileIcon"
                android:background="@drawable/ui_sys_noti_tile_purple"
                android:src="@drawable/ic_ui_mic"
                android:tint="@color/home_purple" />

            <TextView
                android:id="@+id/pinLabelVoice"
                style="@style/UiSysNotiTileLabel"
                tools:text="Voice" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinTileCamera"
            style="@style/UiSysNotiTile"
            android:layout_marginStart="6dp">

            <ImageView
                style="@style/UiSysNotiTileIcon"
                android:background="@drawable/ui_sys_noti_tile_teal"
                android:src="@drawable/ic_ui_camera"
                android:tint="@color/home_teal" />

            <TextView
                android:id="@+id/pinLabelCamera"
                style="@style/UiSysNotiTileLabel"
                tools:text="Camera" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinTileFile"
            style="@style/UiSysNotiTile"
            android:layout_marginStart="6dp">

            <ImageView
                style="@style/UiSysNotiTileIcon"
                android:background="@drawable/ui_sys_noti_tile_orange"
                android:src="@drawable/ic_ui_image"
                android:tint="@color/home_orange" />

            <TextView
                android:id="@+id/pinLabelFile"
                style="@style/UiSysNotiTileLabel"
                tools:text="File" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
