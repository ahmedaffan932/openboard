<?xml version="1.0" encoding="utf-8"?>
<!-- Premium lock dialog (FragmentsDashboardActivity.showUnlockPremiumDialog).
     Figma: TranslatorProZyro, premium lock (9:1433). The window background is transparent, so this
     root is the card; layout_gravity centres it if the dialog window is wider than the card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="312dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_ui_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_ui_pro_tile"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/home_shadow_pro"
            android:outlineSpotShadowColor="@color/home_shadow_pro"
            tools:targetApi="p">

            <ImageView
                android:id="@+id/ivUnlockHappy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_ui_lock"
                app:tint="@color/home_on_accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHeading"
            style="@style/HomeText.Screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/upgrade_or_watch_ad" />

        <TextView
            android:id="@+id/tvDescription"
            style="@style/HomeText.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/your_are_using_limited_version_please_upgrade_or_watch_ad_to_use_camera_translate" />

        <LinearLayout
            android:id="@+id/actionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnUpgrade"
                style="@style/Widget.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/upgrade_to_pro"
                tools:targetApi="p" />

            <TextView
                android:id="@+id/btnWatchAd"
                style="@style/Widget.Ui.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/watch_ad" />
        </LinearLayout>

        <TextView
            style="@style/HomeText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/ui_sys_premium_caption"
            android:textColor="@color/home_text_muted" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnClose"
        style="@style/Widget.Ui.IconButton"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:contentDescription="@string/close"
        app:srcCompat="@drawable/ic_ui_x" />
</FrameLayout>
