<?xml version="1.0" encoding="utf-8"?><!--
    The "Add widget" card (widget/WidgetPromptDialog). Figma: TranslatorProZyro, add widget (9:1964).
    The card's surface is the dialog WINDOW's background (bg_ui_dialog, set in code), so this root has
    none; the dialog clips it to the card's rounded outline in code, which is what rounds the ad's
    corners. "Got it" opens the launcher's pin dialog directly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWidgetPromptTitle"
            style="@style/HomeText.Screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="56dp"
            android:gravity="center"
            android:text="@string/widget_prompt_title"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvWidgetPromptSubtitle"
            style="@style/HomeText.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="@string/widget_promo_desc" />

        <!-- What the widget looks like (widget_translate.xml): logo, hint, mic, camera. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/ui_sys_widget_pill"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:outlineSpotShadowColor="@color/home_shadow"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:targetApi="p">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/app_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/word_phrase_or_sentence"
                android:textColor="@color/home_hint"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_ui_circle_accent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_ui_mic"
                    app:tint="@color/home_accent" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_ui_circle_accent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_ui_camera"
                    app:tint="@color/home_accent" />
            </FrameLayout>
        </LinearLayout>

        <include
            android:id="@+id/step1"
            layout="@layout/item_widget_prompt_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp" />

        <include
            android:id="@+id/step2"
            layout="@layout/item_widget_prompt_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp" />

        <include
            android:id="@+id/step3"
            layout="@layout/item_widget_prompt_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/btnWidgetPromptGotIt"
            style="@style/Widget.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/widget_prompt_got_it" />

        <!-- Always there: the gap above the ad, or the card's bottom padding when no ad fills. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <FrameLayout
            android:id="@+id/widgetPromptAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnWidgetPromptClose"
        style="@style/Widget.Ui.IconButton"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:contentDescription="@string/noti_close"
        app:srcCompat="@drawable/ic_ui_x" />
</FrameLayout>
