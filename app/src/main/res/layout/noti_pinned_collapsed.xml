<?xml version="1.0" encoding="utf-8"?><!--
    Collapsed pinned notification. The design only draws the expanded card (Figma 11:2354), but a
    low-importance notification usually sits collapsed, and a collapsed row that only repeated the
    title would put every tool behind an expand. So the collapsed row is the four tools themselves,
    as soft-tone chips (the expanded tiles' colours) packed into the ~38dp an API 27-30 collapsed
    custom view gets: 18dp glyph over a 10sp label (pinned in dp below API 28, where that budget does
    not grow with the font scale). layout-v31/ has the 48dp version. Same ids as
    noti_pinned_expanded.xml, so the same code wires both.

    Inflated by SystemUI: framework views and attributes only; texts are set from code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="UseAppTint">

        <LinearLayout
            android:id="@+id/pinTileTranslate"
            style="@style/UiSysNotiChip"
            android:background="@drawable/ui_sys_noti_tile_accent">

            <ImageView
                style="@style/UiSysNotiChipIcon"
                android:src="@drawable/ic_ui_languages"
                android:tint="@color/home_accent" />

            <TextView
                android:id="@+id/pinLabelTranslate"
                style="@style/UiSysNotiChipLabel"
                tools:text="Translate" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinTileVoice"
            style="@style/UiSysNotiChip"
            android:layout_marginStart="6dp"
            android:background="@drawable/ui_sys_noti_tile_purple">

            <ImageView
                style="@style/UiSysNotiChipIcon"
                android:src="@drawable/ic_ui_mic"
                android:tint="@color/home_purple" />

            <TextView
                android:id="@+id/pinLabelVoice"
                style="@style/UiSysNotiChipLabel"
                tools:text="Voice" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinTileCamera"
            style="@style/UiSysNotiChip"
            android:layout_marginStart="6dp"
            android:background="@drawable/ui_sys_noti_tile_teal">

            <ImageView
                style="@style/UiSysNotiChipIcon"
                android:src="@drawable/ic_ui_camera"
                android:tint="@color/home_teal" />

            <TextView
                android:id="@+id/pinLabelCamera"
                style="@style/UiSysNotiChipLabel"
                tools:text="Camera" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinTileFile"
            style="@style/UiSysNotiChip"
            android:layout_marginStart="6dp"
            android:background="@drawable/ui_sys_noti_tile_orange">

            <ImageView
                style="@style/UiSysNotiChipIcon"
                android:src="@drawable/ic_ui_image"
                android:tint="@color/home_orange" />

            <TextView
                android:id="@+id/pinLabelFile"
                style="@style/UiSysNotiChipLabel"
                tools:text="File" />
        </LinearLayout>
</LinearLayout>
