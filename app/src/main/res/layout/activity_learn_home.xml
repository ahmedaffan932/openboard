<?xml version="1.0" encoding="utf-8"?>
<!-- Learn course map. Figma TranslatorProZyro "Learn · Course map" (section 11): header with course chip,
     streak and XP, daily-goal and practice tiles, then one card per unit (built in LearnHomeActivity
     from item_learn_unit), small native ad at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    tools:context=".learn.LearnHomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Ui.IconButton"
            android:contentDescription="@string/ui_tr_back"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:srcCompat="@drawable/ic_ui_arrow_left"
            app:tint="@color/home_text_primary"
            tools:targetApi="p" />

        <TextView
            style="@style/HomeText.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/learn_home_title" />

        <ImageView
            android:id="@+id/btnSettings"
            style="@style/Widget.Ui.IconButton"
            android:contentDescription="@string/learn_settings_title"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:srcCompat="@drawable/ic_ui_settings"
            app:tint="@color/home_text_primary"
            tools:targetApi="p" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Course chip · streak · XP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/llCourseChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ui_card_r16_clickable"
                    android:clickable="true"
                    android:elevation="1dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    android:paddingStart="6dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    tools:targetApi="p">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivCourseFlag"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/roundedCorners" />

                    <TextView
                        android:id="@+id/tvCourseName"
                        style="@style/HomeText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        tools:text="Spanish" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_ui_chevron_down"
                        app:tint="@color/home_text_secondary" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvStreak"
                    style="@style/HomeText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_learn_chip_orange"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/home_orange"
                    app:drawableStartCompat="@drawable/ic_ui_flame"
                    app:drawableTint="@color/home_orange"
                    tools:text="4" />

                <TextView
                    android:id="@+id/tvXp"
                    style="@style/HomeText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_learn_chip_accent"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/home_accent"
                    app:drawableStartCompat="@drawable/ic_ui_zap"
                    app:drawableTint="@color/home_accent"
                    tools:text="120 XP" />
            </LinearLayout>

            <!-- Daily goal · Practice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ui_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    android:padding="14dp"
                    tools:targetApi="p">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_ui_tile_accent">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_ui_target"
                                app:tint="@color/home_accent" />
                        </FrameLayout>

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/learn_daily_goal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGoal"
                        style="@style/HomeText.CaptionMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/home_text_secondary"
                        tools:text="1 of 2 lessons" />

                    <ProgressBar
                        android:id="@+id/pbGoal"
                        style="@style/Widget.Ui.Progress"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        tools:progress="50" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPractice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ui_card_clickable"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    android:padding="14dp"
                    tools:targetApi="p">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_ui_tile_teal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                app:srcCompat="@drawable/ic_ui_refresh"
                                app:tint="@color/home_teal" />
                        </FrameLayout>

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/learn_practice" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPracticeDue"
                        style="@style/HomeText.CaptionMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/home_text_secondary"
                        tools:text="12 words to review" />

                    <TextView
                        android:id="@+id/tvPracticeStart"
                        style="@style/HomeText.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/learn_practice_start"
                        android:textColor="@color/home_teal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/flAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
