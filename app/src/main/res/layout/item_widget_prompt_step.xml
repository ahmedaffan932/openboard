<?xml version="1.0" encoding="utf-8"?><!-- One numbered step of the "Add widget" card (Figma 9:1964): accent_soft number badge, title and
     hint. Texts are set by WidgetPromptDialog; it also sets widgetStepIcon, which the design no
     longer shows (kept, gone, for the binding). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/widgetStepNumber"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_ui_circle_accent"
        android:fontFamily="@font/manrope_extrabold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/home_accent"
        android:textSize="13sp"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetStepTitle"
            style="@style/HomeText.BodyStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Long-press your home screen" />

        <TextView
            android:id="@+id/widgetStepDesc"
            style="@style/HomeText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Tap and hold on an empty area" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widgetStepIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:tint="@color/home_text_muted"
        tools:src="@drawable/ic_widget_step_touch" />
</LinearLayout>
