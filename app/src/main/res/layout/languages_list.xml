<?xml version="1.0" encoding="utf-8"?>
<!-- A language row inside a card (Language selector, Conversation's language sheet).
     Figma: TranslatorProZyro "Translate to" (6:816). LanguagesAdapter swaps the background to
     bg_ui_row_selected and shows ivSelected for the chosen language, and sets the download state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lngLayoutActivity"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ui_row_ripple"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="8dp"
        android:paddingBottom="9dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/flagView"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/roundedCorners"
            tools:src="@drawable/us_flag" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/languageName"
                style="@style/HomeText.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                tools:text="Spanish" />

            <TextView
                android:id="@+id/tvNativeName"
                style="@style/HomeText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:visibility="gone"
                tools:text="Español"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewPremium"
            style="@style/HomeText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ui_badge_pro"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/premium"
            android:textColor="@color/home_on_accent"
            android:visibility="gone" />

        <!-- Speak + download state; hidden on the selected row. -->
        <LinearLayout
            android:id="@+id/llRowActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnSpeakTranslation"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_home_icon_ripple"
                android:contentDescription="@string/speak"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_ui_speaker"
                app:tint="@color/home_text_muted" />

            <ImageView
                android:id="@+id/ivDownloadLanguage"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_home_icon_ripple"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_ui_download"
                app:tint="@color/home_accent" />

            <ProgressBar
                android:id="@+id/pbDownloading"
                style="?android:attr/progressBarStyle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:indeterminateTint="@color/home_accent"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivSelected"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_ui_check"
            app:tint="@color/home_accent" />
    </LinearLayout>

    <!-- 1dp divider, inset past the flag (12 + 28 + 12dp). -->
    <View
        android:id="@+id/vRowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="12dp"
        android:background="@color/home_border" />

</LinearLayout>
