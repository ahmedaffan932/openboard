<?xml version="1.0" encoding="utf-8"?>
<!-- Phrase details: a phrase group header (Figma 6:1286). CustomExpandableListAdapter sets the card
     background (whole card when collapsed, the card's top when expanded), the icon tile, the phrase
     count and the chevron. The root's top padding is the gap between groups. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:id="@+id/clMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ui_tabs_bg_group_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/flItemIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ui_tile_danger">

                <ImageView
                    android:id="@+id/imgItemIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_ui_utensils" />
            </FrameLayout>

            <TextView
                android:id="@+id/listTitle"
                style="@style/HomeText.CardLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Ordering food" />

            <TextView
                android:id="@+id/tvGroupCount"
                style="@style/HomeText.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_ui_chip_soft"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:textColor="@color/home_accent"
                tools:text="8" />

            <ImageView
                android:id="@+id/btnItemNext"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ui_chevron_down"
                android:tint="@color/home_text_muted" />
        </LinearLayout>

        <!-- Shown while the group is open: separates the header from its first phrase. -->
        <View
            android:id="@+id/vGroupDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/home_border"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
