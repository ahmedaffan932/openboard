<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/suggestions_strip_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:gravity="center_vertical"
        android:hapticFeedbackEnabled="false"
        android:orientation="vertical"
        android:soundEffectsEnabled="false">

        <!-- Translate row. Figma: TranslatorProZyro, keyboard (11:2185): language pills that hug
             their content (flag + name, Manrope Bold 13), the swap arrows in accent, and the gradient
             "Translate" pill on the right. Each pill's name is 0dp + weight inside a wrap_content
             pill, so the pill hugs the name while there is room and the name ellipsizes (the flag
             stays) when there is not. SuggestionStripView colours the pills, names and arrows for
             the keyboard theme (translucent white on dark keyboards). The IME inflates this without
             AppCompat's view factory, so plain views take framework attributes only. -->
        <LinearLayout
            android:id="@+id/llTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding"
            android:paddingTop="@dimen/padding">

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:animateLayoutChanges="true"
                android:gravity="center_vertical|start"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/llLngFrom"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/ui_sys_kb_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingEnd="11dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/flagFrom"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kr_flag"
                        app:shapeAppearanceOverlay="@style/roundedCorners" />

                    <TextView
                        android:id="@+id/tvLngFrom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/manrope_bold"
                        android:includeFontPadding="false"
                        android:maxWidth="96dp"
                        android:singleLine="true"
                        android:text="@string/english"
                        android:textColor="@color/ui_sys_kb_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnSwitchLngs"
                    android:layout_width="30dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_ui_round_ripple"
                    android:contentDescription="@string/swap_languages"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="7dp"
                    android:src="@drawable/ic_ui_swap"
                    android:tint="@color/ui_sys_kb_accent" />

                <LinearLayout
                    android:id="@+id/llLngTo"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/ui_sys_kb_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="7dp">

                    <TextView
                        android:id="@+id/tvLngTo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/manrope_bold"
                        android:includeFontPadding="false"
                        android:maxWidth="96dp"
                        android:singleLine="true"
                        android:text="@string/textview"
                        android:textColor="@color/ui_sys_kb_text"
                        android:textSize="13sp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/flagTo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kr_flag"
                        app:shapeAppearanceOverlay="@style/roundedCorners" />
                </LinearLayout>
            </LinearLayout>

            <!-- tvTranslate goes INVISIBLE (not gone) while translating, so the pill keeps its width
                 and the spinner sits in its middle. -->
            <LinearLayout
                android:id="@+id/btn_translate"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/padding"
                android:background="@drawable/bg_home_translate_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="13dp"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tvTranslate"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:drawablePadding="5dp"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxWidth="120dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/translate"
                        android:textColor="@color/home_on_accent"
                        android:textSize="13sp"
                        android:visibility="visible"
                        android:drawableStart="@drawable/ui_sys_kb_ic_translate" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/home_on_accent"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/padding"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/suggestions_strip_other_key"
                style="?attr/suggestionWordStyle"
                android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                android:layout_height="fill_parent"
                android:layout_weight="0"
                android:contentDescription="@string/more_keys_strip_description" />

            <ImageButton
                android:id="@+id/suggestions_strip_clipboard_key"
                style="?attr/suggestionWordStyle"
                android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                android:layout_height="fill_parent"
                android:visibility="gone" />

            <!-- A recently copied link or text, offered for one tap (LatinIME.maybeOfferRecentClip).
                 While shown, it takes the place of the word suggestions. -->
            <TextView
                android:id="@+id/suggestions_strip_clip_chip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/less_padding"
                android:layout_marginVertical="4dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_effect_rounded"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
                 We just need to ignore the system's audio and haptic feedback settings. -->
            <LinearLayout
                android:id="@+id/suggestions_strip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="false"
                android:maxWidth="100dp"
                android:orientation="horizontal"
                android:soundEffectsEnabled="false" />


            <ImageButton
                android:id="@+id/suggestions_strip_voice_key"
                style="?attr/suggestionWordStyle"
                android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
                android:layout_height="fill_parent"
                android:contentDescription="@string/spoken_description_mic" />

        </LinearLayout>

    </LinearLayout>
</merge>
