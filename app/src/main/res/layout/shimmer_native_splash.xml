<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder for admob_native_splash.xml: centred icon, headline, caption and body
     blocks, a full-width CTA block. The card is the shimmer layout's own background. -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerViewThe"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ui_card"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp"
    app:shimmer_auto_start="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/ui_sys_shimmer_icon" />

        <View
            android:layout_width="180dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ui_sys_shimmer_block" />

        <View
            android:layout_width="90dp"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ui_sys_shimmer_block" />

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/ui_sys_shimmer_block" />

        <View
            android:layout_width="200dp"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/ui_sys_shimmer_block" />

        <View
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/ui_sys_shimmer_pill" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
