<?xml version="1.0" encoding="utf-8"?>
<!-- Favorites. Figma: TranslatorProZyro "Favorites" (6:1174), empty state (20:5279).
     Cards are history_item_home (the Home tab's Recent cards); the filled heart removes a card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    tools:context="org.dslul.openboard.translator.pro.DisplayFavoritesActivity">

    <!-- Header: back, title. -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Ui.IconButton"
            android:contentDescription="@string/ui_tr_back"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:srcCompat="@drawable/ic_ui_arrow_left"
            app:tint="@color/home_text_primary"
            tools:targetApi="p" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/HomeText.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/favorites" />
    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewFavorites"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                app:layout_constraintBottom_toTopOf="@+id/nativeAdFrameLayout"
                app:layout_constraintTop_toTopOf="parent"
                tools:listitem="@layout/history_item_home" />

            <FrameLayout
                android:id="@+id/nativeAdFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_200sdp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_home_ad_card"
                android:elevation="2dp"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:targetApi="p" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Empty state. -->
        <LinearLayout
            android:id="@+id/llEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="48dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/animLoading"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_ui_circle_danger">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_ui_heart"
                    app:tint="@color/home_heart" />
            </FrameLayout>

            <TextView
                style="@style/HomeText.CardLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/ui_tr_favorites_empty_title" />

            <TextView
                android:id="@+id/tvNoFavorites"
                style="@style/HomeText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/ui_tr_favorites_empty_body" />

            <TextView
                android:id="@+id/btnOpenHistory"
                style="@style/Widget.Ui.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:minWidth="216dp"
                android:outlineSpotShadowColor="@color/home_shadow_blue"
                android:text="@string/ui_tr_open_history"
                tools:targetApi="p" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
