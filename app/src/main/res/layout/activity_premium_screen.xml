<?xml version="1.0" encoding="utf-8"?>
<!-- Premium. Figma TranslatorProZyro "Premium" (4:469): close button, crown tile, title, the
     BASIC / PRO comparison card, price line, Start free trial, fine print and legal links.
     The old plan cards (clWeekly / clMonthly) and the purchase overlay (clPB) stay, hidden. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    tools:context="org.dslul.openboard.translator.pro.PremiumScreenActivity">

    <!-- Soft warm circle behind the top right corner. -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_ui_circle_orange"
        android:importantForAccessibility="no"
        android:translationX="90dp"
        android:translationY="-110dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btnDismiss"
            style="@style/Widget.Ui.IconButton"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/close"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_ui_x"
            tools:visibility="visible" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_ui_pro_tile"
                    android:elevation="10dp"
                    android:outlineAmbientShadowColor="@color/home_shadow_pro"
                    android:outlineSpotShadowColor="@color/home_shadow_pro"
                    tools:targetApi="p">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_ui_crown_filled"
                        app:tint="@color/home_on_accent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/HomeText.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/ui_launch_premium_title" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/HomeText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/ui_launch_premium_subtitle" />

                <!-- Comparison card: Features / BASIC / PRO. -->
                <LinearLayout
                    android:id="@+id/clFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_ui_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="6dp"
                    tools:targetApi="p">

                    <LinearLayout
                        android:id="@+id/clTicks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="28dp"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp">

                        <TextView
                            style="@style/HomeText.CaptionMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/features" />

                        <TextView
                            android:id="@+id/tvBasic"
                            style="@style/HomeText.Chip"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:singleLine="true"
                            android:text="@string/premium_basic" />

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvPremium"
                                style="@style/HomeText.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_ui_badge_pro"
                                android:gravity="center"
                                android:paddingHorizontal="8dp"
                                android:singleLine="true"
                                android:text="@string/home_pro_button"
                                android:textColor="@color/home_on_accent" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_infinity"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_unlimited_translations" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_check"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_bot"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_ai_chat_assistant" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_check"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_scan_text"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_camera_text_translate" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_lock"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_keyboard"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_all_language_keyboard" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_lock"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_mic"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_voice_translation" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_lock"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_download"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_offline_language_packs" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_lock"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_book"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_premium_phrasebook" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_lock"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_border" />

                    <!-- Learn (translator/pro/learn) is a Pro feature. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_graduation_cap"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_language_courses" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_lock"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/home_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_ban"
                            app:tint="@color/home_accent" />

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:text="@string/premium_feature_ad_free_experience" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_lock"
                            app:tint="@color/home_text_muted" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_ui_circle_check"
                            app:tint="@color/home_success" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Old plan picker: kept for PremiumScreenActivity, never shown. -->
                <LinearLayout
                    android:id="@+id/llPurchaseItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/clWeekly"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/clMonthly"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMonthly"
                            style="@style/HomeText.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/monthly" />

                        <TextView
                            android:id="@+id/tvMonthlyPrice"
                            style="@style/HomeText.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/subscription_price_placeholder" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Price, CTA, fine print, legal links: pinned under the scrolling content. -->
        <LinearLayout
            android:id="@+id/constraintLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvWeeklyPrice"
                style="@style/HomeText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/subscription_price_loading" />

            <TextView
                android:id="@+id/btnGetPro"
                style="@style/Widget.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/ui_launch_premium_cta" />

            <TextView
                android:id="@+id/tv"
                style="@style/HomeText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="8dp"
                android:text="@string/premium_trial_terms"
                android:textColor="@color/home_text_muted" />

            <LinearLayout
                android:id="@+id/llLegalLinks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTerms"
                    style="@style/HomeText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_text_button"
                    android:fontFamily="@font/manrope_medium"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="6dp"
                    android:text="@string/premium_terms_of_use" />

                <TextView
                    style="@style/HomeText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="2dp"
                    android:text="@string/ui_launch_separator"
                    android:textColor="@color/home_text_muted" />

                <TextView
                    android:id="@+id/tvPrivacyPolicy"
                    style="@style/HomeText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_text_button"
                    android:fontFamily="@font/manrope_medium"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="6dp"
                    android:text="@string/privacy_policy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Purchase overlay (unused by the current flow; swallows taps while shown). -->
    <FrameLayout
        android:id="@+id/clPB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_ui_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimationView"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="loading_ad.json"
                app:lottie_loop="true" />

            <TextView
                style="@style/HomeText.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/fetching_information" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
