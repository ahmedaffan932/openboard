<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dashboard"
    android:backgroundTint="#ffffff"
    tools:context="org.dslul.openboard.translator.pro.PremiumScreenActivity">

    <ImageView
        android:id="@+id/btnDismiss"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:layout_margin="@dimen/fab_padding"
        android:background="@drawable/bg_nothing_rounded_ripple"
        android:elevation="@dimen/less_padding"
        android:padding="@dimen/padding"
        android:src="@drawable/ic_dismiss_premium_screen"
        android:transitionName="animBack"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#A0A0A0" />

    <ImageView
        android:id="@+id/img"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="@dimen/padding"
        android:background="@drawable/bg_nothing_rounded_ripple"
        android:elevation="@dimen/less_padding"
        android:src="@drawable/ic_premium"
        android:transitionName="animBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnDismiss"
        app:tint="#5E82B8" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:letterSpacing="-0.02"
        android:text="@string/start_like_a_pro"
        android:textColor="@color/black"
        android:textSize="@dimen/_18sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:letterSpacing="-0.02"
        android:text="@string/unlock_all_features"
        android:textColor="#808080"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/fab_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDescription">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTicks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/fab_padding"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/premium_caps"
                android:textColor="#808080"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintEnd_toStartOf="@id/tvBasic"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@id/tvPremium"
                app:layout_constraintStart_toStartOf="@id/tvPremium"
                app:layout_constraintTop_toBottomOf="@id/tvPremium">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@id/tvBasic"
                app:layout_constraintStart_toStartOf="@id/tvBasic"
                app:layout_constraintTop_toBottomOf="@id/tvBasic">


                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_tick"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_ask"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_ask"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_ask"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_ask"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_ask"
                    app:tint="#5E82B8" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/fab_padding"
                    android:src="@drawable/ic_ask"
                    app:tint="#5E82B8" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBasic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/padding"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/premium_basic"
                android:textColor="#808080"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/clFeatures"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="52dp"
            android:layout_marginBottom="@dimen/padding"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/btnGetPro"
            app:layout_constraintTop_toTopOf="parent">


            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/m_padding"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/less_padding"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_baseline_translate_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#5E82B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/m_padding"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/premium_feature_unlimited_translations"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/less_padding"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/less_padding"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_baseline_chat_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#5E82B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/m_padding"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/premium_feature_ai_chat_assistant"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/less_padding"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/less_padding"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_baseline_camera_alt_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#5E82B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/m_padding"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/premium_feature_camera_text_translate"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/less_padding"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/less_padding"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_keyboard"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#5E82B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/m_padding"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/premium_feature_all_language_keyboard"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/less_padding"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/less_padding"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_voice"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#5E82B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/m_padding"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/premium_feature_voice_translation"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/less_padding"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/less_padding"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/outline_download_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#5E82B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/m_padding"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/premium_feature_offline_language_packs"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/less_padding"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/less_padding"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_phrases"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#5E82B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/m_padding"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/premium_feature_premium_phrasebook"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/less_padding"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/less_padding"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="@dimen/less_padding"
                    android:src="@drawable/ic_no_ads"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#5E82B8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/m_padding"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/premium_feature_ad_free_experience"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPurchaseItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clWeekly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="@dimen/padding"
                    android:layout_marginBottom="@dimen/less_padding"
                    android:layout_weight="1"
                    android:background="@drawable/bg_in_app_item_selected"
                    android:elevation="2dp"
                    android:transitionName="animAd">


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clMonthly"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="@dimen/less_padding"
                    android:layout_weight="1"
                    android:background="@drawable/bg_in_app_item"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvMonthly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_top_in_app_item_un_selected"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:padding="@dimen/less_padding"
                            android:text="@string/monthly"
                            android:textColor="@color/accent_light"
                            android:textSize="@dimen/_12sdp"
                            app:layout_constraintBottom_toBottomOf="@id/img"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvMonthlyPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/less_padding"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/subscription_price_placeholder"
                            android:textColor="@color/text_color_premium"
                            android:textSize="@dimen/_12sdp"
                            app:layout_constraintBottom_toBottomOf="@id/img"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/padding"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/pre_month"
                            android:textColor="@color/text_color_premium"
                            android:textSize="@dimen/_12sdp"
                            app:layout_constraintBottom_toBottomOf="@id/img"
                            app:layout_constraintStart_toStartOf="parent" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/btnGetPro">

            <TextView
                android:id="@+id/tvWeeklyPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_medium"
                android:text="@string/subscription_price_loading"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="@id/img"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_medium"
                android:text="@string/premium_trial_price_suffix"
                android:textColor="#808080"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="@id/img"
                app:layout_constraintStart_toStartOf="parent" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnGetPro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/less_padding"
            android:background="@drawable/bg_accent_padding_rounded"
            android:backgroundTint="#4F7BD9"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center"
            android:paddingHorizontal="@dimen/fab_padding"
            android:paddingVertical="@dimen/fab_padding"
            android:text="@string/premium_start_free_trial"
            android:textColor="@color/btnTextColor"
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold"
            android:transitionName="btnContinue"
            app:layout_constraintBottom_toTopOf="@id/tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fab_padding"
            android:fontFamily="@font/sf_pro_medium"
            android:gravity="center"
            android:paddingHorizontal="@dimen/padding"
            android:text="@string/premium_trial_terms"
            android:textColor="#808080"
            android:textSize="@dimen/_9sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <TextView
            android:id="@+id/tvPrivacyPolicy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/padding"
            android:layout_marginBottom="@dimen/fab_padding"
            android:gravity="center"
            android:text="@string/privacy_policy"
            android:textColor="@color/text_color_premium"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/padding"
            android:layout_marginBottom="@dimen/fab_padding"
            android:gravity="center"
            android:text="@string/terms_of_use"
            android:textColor="@color/text_color_premium"
            android:textSize="@dimen/_10sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clPB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_main_less_rounded"
            android:padding="@dimen/fab_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimationView"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_150sdp"
                app:layout_constraintEnd_toEndOf="parent"
