<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder for admob_native_dashboard.xml: same card, grey blocks in place of content. -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_ad_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp">

        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_home_icon_tile_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:background="@drawable/shape_home_lang_pill" />

            <View
                android:layout_width="96dp"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_home_lang_pill" />
        </LinearLayout>

        <View
            android:layout_width="72dp"
            android:layout_height="34dp"
            android:layout_marginStart="11dp"
            android:background="@drawable/shape_home_ad_install" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
