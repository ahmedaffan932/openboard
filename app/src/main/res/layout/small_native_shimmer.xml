<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder for the small native ads (admob_small_native_ad_*): the same card with
     blocks for icon, headline, body line and a full-width CTA. The card is the shimmer layout's own
     background, so it stays solid while only the blocks shimmer. -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerViewThe"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_ad_card"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    app:shimmer_auto_start="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ui_sys_shimmer_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:id="@+id/firstT"
                    android:layout_width="140dp"
                    android:layout_height="12dp"
                    android:background="@drawable/ui_sys_shimmer_block" />

                <View
                    android:id="@+id/secondT"
                    android:layout_width="96dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ui_sys_shimmer_block" />
            </LinearLayout>

            <View
                android:layout_width="22dp"
                android:layout_height="14dp"
                android:layout_gravity="top"
                android:layout_marginStart="8dp"
                android:background="@drawable/ui_sys_shimmer_block" />
        </LinearLayout>

        <View
            android:id="@+id/thirdT"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/ui_sys_shimmer_block" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/ui_sys_shimmer_pill" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
