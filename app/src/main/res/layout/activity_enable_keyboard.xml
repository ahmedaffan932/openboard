<?xml version="1.0" encoding="utf-8"?>
<!-- Enable keyboard (translucent activity). Figma: TranslatorProZyro "Enable keyboard" (7:1207):
     a bottom sheet over the dimmed app with the keyboard tile, a toolbar preview and the two steps.
     Step 2 is an inactive row until the keyboard is enabled; then clSelectKeyboard replaces it. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_scrim"
    tools:context="org.dslul.openboard.translator.pro.EnableKeyboardActivity">

    <LinearLayout
        android:id="@+id/llSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ui_sheet"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="vertical"
        android:outlineSpotShadowColor="@color/home_shadow"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:targetApi="p">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ui_sheet_handle" />

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/ui_tr_bg_tile_accent_lg">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_ui_keyboard"
                app:tint="@color/home_accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHeading"
            style="@style/HomeText.Screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/translator_pro_keyboard" />

        <TextView
            style="@style/HomeText.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui_tr_keyboard_subtitle" />

        <!-- The old illustration; the toolbar preview below replaces it. -->
        <ImageView
            android:id="@+id/iv_feature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Keyboard toolbar preview: the user's language pair + Translate (filled in by the code). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ui_input"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:padding="7dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/ui_tr_bg_chip_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPreviewFlagFrom"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/us_flag"
                    app:shapeAppearanceOverlay="@style/roundedCorners" />

                <TextView
                    android:id="@+id/tvPreviewFrom"
                    style="@style/HomeText.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxWidth="72dp"
                    android:singleLine="true"
                    android:textSize="11sp"
                    tools:text="EN" />
            </LinearLayout>

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="6dp"
                app:srcCompat="@drawable/ic_ui_swap"
                app:tint="@color/home_accent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/ui_tr_bg_chip_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPreviewFlagTo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/by_flag"
                    app:shapeAppearanceOverlay="@style/roundedCorners" />

                <TextView
                    android:id="@+id/tvPreviewTo"
                    style="@style/HomeText.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxWidth="72dp"
                    android:singleLine="true"
                    android:textSize="11sp"
                    tools:text="ES" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_ui_button_primary"
                android:fontFamily="@font/manrope_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:text="@string/translate"
                android:textColor="@color/home_on_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Steps card. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ui_card"
            android:orientation="vertical"
            android:padding="2dp">

            <!-- Step 1: enable. Greyed out with a check once done (EnableKeyboardActivity). -->
            <LinearLayout
                android:id="@+id/clEnableKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_row_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <TextView
                        android:id="@+id/tvHintMeaning"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_ui_circle_primary"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/step_number_1"
                        android:textColor="@color/home_on_accent"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/ivStepOneDone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_ui_check"
                        app:tint="@color/home_on_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textEnable"
                        style="@style/HomeText.BodyStrong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_translator_keyboard" />

                    <TextView
                        android:id="@+id/tvStepOneSubtitle"
                        style="@style/HomeText.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ui_tr_keyboard_step1_subtitle" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivStepOneChevron"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_ui_chevron_right"
                    app:tint="@color/home_text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="52dp"
                android:layout_marginEnd="12dp"
                android:background="@color/home_border" />

            <!-- Step 2: switch. The inactive row shows until the keyboard is enabled. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/llSwitchKeyboardInactive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/ui_tr_bg_circle_muted"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/step_number_2"
                        android:textColor="@color/home_text_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/switch_keyboard" />

                        <TextView
                            style="@style/HomeText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ui_tr_keyboard_step2_subtitle" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_ui_chevron_right"
                        app:tint="@color/home_text_muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/clSelectKeyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ui_row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="invisible">

                    <TextView
                        android:id="@+id/tv_ad"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_ui_circle_primary"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/step_number_2"
                        android:textColor="@color/home_on_accent"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSelect"
                            style="@style/HomeText.BodyStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/switch_keyboard" />

                        <TextView
                            style="@style/HomeText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ui_tr_keyboard_step2_subtitle" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_ui_chevron_right"
                        app:tint="@color/home_text_muted" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvSkip"
            style="@style/HomeText.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_text_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/ui_tr_maybe_later"
            android:textColor="@color/home_text_secondary" />

        <FrameLayout
            android:id="@+id/nativeAdFrameLayoutSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_ad_card"
            android:visibility="invisible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
