<?xml version="1.0" encoding="utf-8"?>
<!-- Exit. Figma TranslatorProZyro "Exit" (12:2297) and its rated state (21:5605): logo, name and
     quote, a rating card (ExitActivity fills the stars and swaps the texts once rated), a quit
     card with No / Yes, quit, and a small native ad at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    tools:context="org.dslul.openboard.translator.pro.ExitActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/clMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/ui_launch_logo_tile"
                android:elevation="10dp"
                android:importantForAccessibility="no"
                android:outlineAmbientShadowColor="@color/home_shadow_blue"
                android:outlineSpotShadowColor="@color/home_shadow_blue"
                android:src="@drawable/app_logo"
                tools:targetApi="p" />

            <TextView
                style="@style/HomeText.Screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/tvText1"
                style="@style/HomeText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/a_translator_is_a_reader_an_interpreter_and_a_creator_all_in_one" />

            <!-- Rating card. -->
            <LinearLayout
                android:id="@+id/clRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="14dp"
                tools:targetApi="p">

                <TextView
                    android:id="@+id/tvRateTitle"
                    style="@style/HomeText.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/ui_launch_exit_rate_title" />

                <!-- Five stars; ExitActivity handles the taps (was a RatingBar). -->
                <LinearLayout
                    android:id="@+id/exit_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/star1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ui_round_ripple"
                        android:padding="6dp"
                        app:srcCompat="@drawable/ic_ui_star"
                        app:tint="@color/home_text_muted" />

                    <ImageView
                        android:id="@+id/star2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_ui_round_ripple"
                        android:padding="6dp"
                        app:srcCompat="@drawable/ic_ui_star"
                        app:tint="@color/home_text_muted" />

                    <ImageView
                        android:id="@+id/star3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_ui_round_ripple"
                        android:padding="6dp"
                        app:srcCompat="@drawable/ic_ui_star"
                        app:tint="@color/home_text_muted" />

                    <ImageView
                        android:id="@+id/star4"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_ui_round_ripple"
                        android:padding="6dp"
                        app:srcCompat="@drawable/ic_ui_star"
                        app:tint="@color/home_text_muted" />

                    <ImageView
                        android:id="@+id/star5"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_ui_round_ripple"
                        android:padding="6dp"
                        app:srcCompat="@drawable/ic_ui_star"
                        app:tint="@color/home_text_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRateHint"
                    style="@style/HomeText.CaptionMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/ui_launch_exit_rate_hint" />
            </LinearLayout>

            <!-- Quit card. -->
            <LinearLayout
                android:id="@+id/clExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_ui_card"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp"
                tools:targetApi="p">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ui_tile_danger">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_ui_log_out"
                        app:tint="@color/home_danger" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvQuit"
                    style="@style/HomeText.AppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/ui_launch_exit_quit_title" />

                <TextView
                    android:id="@+id/textView5"
                    style="@style/HomeText.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/ui_launch_exit_quit_body" />

                <LinearLayout
                    android:id="@+id/llBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnNo"
                        style="@style/Widget.Ui.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/no" />

                    <TextView
                        android:id="@+id/btnYes"
                        style="@style/Widget.Ui.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/ui_launch_exit_yes_quit" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/nativeAdFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

</LinearLayout>
