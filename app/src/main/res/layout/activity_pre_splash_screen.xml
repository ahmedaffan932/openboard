<?xml version="1.0" encoding="utf-8"?>
<!-- Splash. Figma TranslatorProZyro "Splash" (4:40): logo tile, app name, tagline, slim progress
     bar + "Loading…", native ad at the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/home_bg"
    android:clipChildren="false"
    tools:context="org.dslul.openboard.translator.pro.PreSplashScreenActivity">

    <!-- Soft background circles (top right, bottom left). -->
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/bg_ui_circle_accent"
        android:importantForAccessibility="no"
        android:translationX="80dp"
        android:translationY="-70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_ui_circle_purple"
        android:importantForAccessibility="no"
        android:translationX="-100dp"
        android:translationY="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/clMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/spline"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/ui_launch_logo_tile_large"
            android:elevation="12dp"
            android:importantForAccessibility="no"
            android:outlineAmbientShadowColor="@color/home_shadow_blue"
            android:outlineSpotShadowColor="@color/home_shadow_blue"
            android:src="@drawable/app_logo"
            tools:targetApi="p" />

        <TextView
            android:id="@+id/tvAppName"
            style="@style/HomeText.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/tvText1"
            style="@style/HomeText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="300dp"
            android:maxLines="3"
            android:text="@string/a_translator_is_a_reader_an_interpreter_and_a_creator_all_in_one" />
    </LinearLayout>

    <!-- Fills over the splash wait (PreSplashScreenActivity animates it). -->
    <ProgressBar
        android:id="@+id/spline"
        style="@style/Widget.Ui.Progress"
        android:layout_width="160dp"
        android:layout_height="6dp"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progress="0"
        app:layout_constraintBottom_toTopOf="@id/tvLoadingMonetization"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvLoadingMonetization"
        style="@style/HomeText.CaptionMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="22dp"
        android:text="@string/ui_launch_loading"
        app:layout_constraintBottom_toTopOf="@id/bannerFrameLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/bannerFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
