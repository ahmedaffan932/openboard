<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/home_bg"
    tools:context="org.dslul.openboard.translator.pro.FragmentsDashboardActivity">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/llCollapsibleBanner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llCollapsibleBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomDock" />

    <!-- Soft shadow cast upwards by the dock (Figma: 0 -8 22). -->
    <View
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:background="@drawable/bg_home_dock_shadow"
        app:layout_constraintBottom_toTopOf="@id/bottomDock" />

    <!-- Bottom dock (Figma "Home — Redesign" 2035:889): divider, the Home tab's native ad, tabs. -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_bg"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/home_border" />

        <!-- Filled by HomeFragment while the Home tab is showing; gone otherwise. -->
        <FrameLayout
            android:id="@+id/dockNativeAdSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/home_bg"
            android:elevation="0dp"
            android:minHeight="@dimen/dashboard_bottom_navigation_min_height"
            android:paddingHorizontal="10dp"
            app:activeIndicatorLabelPadding="3dp"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.App.BottomNavigation.ActiveIndicator"
            app:itemBackground="@android:color/transparent"
            app:itemHorizontalTranslationEnabled="false"
            app:itemIconSize="@dimen/dashboard_bottom_navigation_icon_size"
            app:itemIconTint="@color/home_nav_item"
            app:itemPaddingBottom="@dimen/dashboard_bottom_navigation_item_padding"
            app:itemPaddingTop="@dimen/dashboard_bottom_navigation_item_padding"
            app:itemRippleColor="@color/home_ripple"
            app:itemTextAppearanceActive="@style/TextAppearanceAppBottomNavigationActive"
            app:itemTextAppearanceInactive="@style/TextAppearanceAppBottomNavigationInactive"
            app:itemTextColor="@color/home_nav_item"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/dashboard_bottom_navigation"
            app:paddingBottomSystemWindowInsets="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
