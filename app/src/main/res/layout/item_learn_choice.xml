<?xml version="1.0" encoding="utf-8"?>
<!-- One answer option (Figma "Lesson · Choose translation"): letter box + text. States are set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_ui_card_r16_clickable"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:outlineSpotShadowColor="@color/home_shadow"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    tools:targetApi="p">

    <TextView
        android:id="@+id/tvLetter"
        style="@style/HomeText.Label"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_learn_letter"
        android:gravity="center"
        android:textColor="@color/home_text_secondary"
        tools:text="A" />

    <TextView
        android:id="@+id/tvText"
        style="@style/HomeText.BodyStrong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        tools:text="Buenos días" />
</LinearLayout>
