<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen / splash native ad (no media; AdmobNativeAds nulls it for splash keys). Figma:
     TranslatorProZyro full-screen native (24:5983) style: AD badge top-right, centred 64dp icon,
     headline, rating / "Sponsored", two lines of body and a full-width gradient CTA.
     AdChoices sits top-left, over the card's padding. -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ui_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/HomeAdIconShape" />

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:fontFamily="@font/sora_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/home_text_primary"
                android:textSize="18sp"
                tools:text="WordUp: Vocabulary Builder" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ad_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/manrope_bold"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="★ 4.6"
                    tools:visibility="visible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_medium"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="@string/ui_sys_ad_sponsored"
                    android:textColor="@color/home_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_regular"
                android:gravity="center"
                android:lineSpacingExtra="2sp"
                android:maxLines="2"
                android:textColor="@color/home_text_secondary"
                android:textSize="13sp"
                tools:text="Learn 10 new words a day with quick quizzes and smart reminders." />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ad_call_to_action"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_ui_button_primary"
                android:elevation="6dp"
                android:fontFamily="@font/manrope_bold"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:outlineAmbientShadowColor="@color/home_shadow_blue"
                android:outlineSpotShadowColor="@color/home_shadow_blue"
                android:singleLine="true"
                android:stateListAnimator="@null"
                android:text="@string/install"
                android:textAllCaps="false"
                android:textColor="@color/home_on_accent"
                android:textSize="15sp"
                tools:targetApi="p" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_home_ad_badge"
            android:fontFamily="@font/manrope_extrabold"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/ad_label"
            android:textAllCaps="true"
            android:textColor="@color/home_ad_badge_text"
            android:textSize="9sp" />
    </FrameLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
