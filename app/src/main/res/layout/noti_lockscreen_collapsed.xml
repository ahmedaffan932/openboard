<?xml version="1.0" encoding="utf-8"?><!--
    Collapsed lock-screen notification. On the lock screen this row IS the notification - SystemUI
    keeps keyguard rows collapsed - so it leads with the feature image
    (LockscreenArt.notificationThumb) rather than the logo; from API 31 Android draws the app icon
    at the row's left anyway. The copy and the grey "X" follow the Figma card ("Lockscreen 1-3").

    Inflated by SystemUI: framework views and attributes only, system font families only (an app
    @font is ignored in notifications from API 31). Height stays under the smallest collapsed
    budget, ~38dp on API 24-27 (48dp from 31): 36dp image, 14sp + 13sp lines.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivNotiThumb"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotiTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/noti_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvNotiDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/noti_desc"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnNotiClose"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/noti_ls_close_bg"
        android:contentDescription="@string/noti_close"
        android:padding="9dp"
        android:src="@drawable/ic_round_close_24"
        android:tint="@color/lockscreen_card_close_icon"
        tools:ignore="UseAppTint" />

</LinearLayout>
