<?xml version="1.0" encoding="utf-8"?>
<!-- Rate dialog (classes/RateUsDialog, opened from Settings). Figma: TranslatorProZyro, rate (9:1755).
     SettingsActivity makes the window full width with a transparent background; the margins make the
     card. Bound there: btnClose and btnRateA-E (ImageView), btnRateUs (ConstraintLayout).
     RateUsDialog fills the stars up to the one under the finger. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:background="@drawable/bg_ui_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/ui_sys_tile_orange_lg">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_ui_star_filled"
                app:tint="@color/home_orange" />
        </FrameLayout>

        <TextView
            android:id="@+id/textView6"
            style="@style/HomeText.Screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/ui_sys_rate_title" />

        <TextView
            android:id="@+id/textView5"
            style="@style/HomeText.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/ui_sys_rate_body" />

        <LinearLayout
            android:id="@+id/linearLayout7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnRateA"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ui_round_ripple"
                android:contentDescription="@string/rate_us"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_ui_star"
                app:tint="@color/home_text_muted" />

            <ImageView
                android:id="@+id/btnRateB"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ui_round_ripple"
                android:contentDescription="@string/rate_us"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_ui_star"
                app:tint="@color/home_text_muted" />

            <ImageView
                android:id="@+id/btnRateC"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ui_round_ripple"
                android:contentDescription="@string/rate_us"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_ui_star"
                app:tint="@color/home_text_muted" />

            <ImageView
                android:id="@+id/btnRateD"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ui_round_ripple"
                android:contentDescription="@string/rate_us"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_ui_star"
                app:tint="@color/home_text_muted" />

            <ImageView
                android:id="@+id/btnRateE"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ui_round_ripple"
                android:contentDescription="@string/rate_us"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_ui_star"
                app:tint="@color/home_text_muted" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnRateUs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_ui_button_primary"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:outlineAmbientShadowColor="@color/home_shadow_blue"
            android:outlineSpotShadowColor="@color/home_shadow_blue"
            tools:targetApi="p">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:includeFontPadding="false"
                android:text="@string/rate_us"
                android:textColor="@color/home_on_accent"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnClose"
        style="@style/Widget.Ui.IconButton"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:contentDescription="@string/close"
        app:srcCompat="@drawable/ic_ui_x" />
</FrameLayout>
