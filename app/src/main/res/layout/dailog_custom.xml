<?xml version="1.0" encoding="utf-8"?>
<!-- Confirm dialog (classes/CustomDialog): "Delete?" from Recent / history, "Remove from favorites?"
     from Favorites - the adapters set tvTitle and wire btnYes / btnNo. Figma: TranslatorProZyro,
     delete (9:1540). The window is full width with a transparent background; the margins make the card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="28dp"
    android:background="@drawable/bg_ui_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/ui_sys_tile_danger_lg">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_ui_trash"
            app:tint="@color/home_danger" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/HomeText.Screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/delete_question" />

    <TextView
        android:id="@+id/tvMessage"
        style="@style/HomeText.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/ui_sys_delete_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNo"
            style="@style/Widget.Ui.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/no" />

        <TextView
            android:id="@+id/btnYes"
            style="@style/Widget.Ui.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/yes" />
    </LinearLayout>
</LinearLayout>
