<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard Home tab. Figma: TranslatorPro, "Home — Redesign · Light" (2035:688) / "· Dark" (2035:929).
     Header and translate card stay put; the feature tiles and Recent list scroll beneath them.
     The native ad sits in the dashboard's bottom dock (activity_fragments_dashboard.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    tools:context="org.dslul.openboard.translator.pro.fragments.HomeFragment">

    <!-- Header: logo, app name, PRO, theme toggle, settings. -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_home_logo"
            android:elevation="4dp"
            android:fontFamily="@font/sora_extrabold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:outlineAmbientShadowColor="@color/home_shadow_blue"
            android:outlineSpotShadowColor="@color/home_shadow_blue"
            android:text="@string/home_logo_mark"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:targetApi="p" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/HomeText.AppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/app_name" />

        <LinearLayout
            android:id="@+id/btnPro"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_pro"
            android:clickable="true"
            android:contentDescription="@string/premium"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/home_shadow_pro"
            android:outlineSpotShadowColor="@color/home_shadow_pro"
            android:paddingStart="10dp"
            android:paddingEnd="11dp"
            tools:targetApi="p">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_crown" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/sora_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/home_pro_button"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnTheme"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_icon_button"
            android:contentDescription="@string/dark_theme"
            android:elevation="1dp"
            android:outlineSpotShadowColor="@color/home_shadow"
            android:padding="9dp"
            android:src="@drawable/ic_home_theme"
            tools:targetApi="p" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_icon_button"
            android:contentDescription="@string/settings"
            android:elevation="1dp"
            android:outlineSpotShadowColor="@color/home_shadow"
            android:padding="9dp"
            android:src="@drawable/ic_home_settings"
            tools:targetApi="p" />
    </LinearLayout>

    <!-- Translate card: language pickers, text field, mic / paste / counter. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/clTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_home_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/home_shadow"
            android:outlineSpotShadowColor="@color/home_shadow"
            android:padding="14dp"
            tools:targetApi="p">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llLanguageSelector"
                android:layout_width="match_parent"
                android:layout_height="40dp">

                <LinearLayout
                    android:id="@+id/llLanguageFrom"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_home_lang_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@id/btnSwitchLngs"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/flagFrom"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/us_flag"
                        app:shapeAppearanceOverlay="@style/roundedCorners" />

                    <TextView
                        android:id="@+id/tvLanguageFrom"
                        style="@style/HomeText.Language"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/english" />

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_chevron_down" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnSwitchLngs"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_home_swap"
                    android:contentDescription="@string/swap_languages"
                    android:padding="10.5dp"
                    android:src="@drawable/ic_home_swap"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/llLanguageTo"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_home_lang_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toEndOf="@id/btnSwitchLngs"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_chevron_down" />

                    <TextView
                        android:id="@+id/tvLanguageTo"
                        style="@style/HomeText.Language"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        tools:text="Spanish" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/flagTo"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/by_flag"
                        app:shapeAppearanceOverlay="@style/roundedCorners" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <EditText
                android:id="@+id/etText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@null"
                android:fontFamily="@font/manrope_medium"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="5000"
                android:maxLines="6"
                android:minHeight="78dp"
                android:paddingHorizontal="2dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical"
                android:textColor="@color/home_text_primary"
                android:textColorHint="@color/home_hint"
                android:textCursorDrawable="@drawable/cursor_home"
                android:textSize="17sp"
                tools:hint="@string/enter_some_text_to_translate" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/home_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <FrameLayout
                    android:id="@+id/btnSpeakInput"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_home_mic"
                    android:clickable="true"
                    android:contentDescription="@string/speak"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:outlineAmbientShadowColor="@color/home_shadow_blue"
                    android:outlineSpotShadowColor="@color/home_shadow_blue"
                    tools:targetApi="p">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_mic" />
                </FrameLayout>

                <!-- Replaces the mic while there is text to translate. -->
                <TextView
                    android:id="@+id/btnTranslate"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_home_translate_button"
                    android:elevation="6dp"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:outlineAmbientShadowColor="@color/home_shadow_blue"
                    android:outlineSpotShadowColor="@color/home_shadow_blue"
                    android:paddingHorizontal="20dp"
                    android:text="@string/translate"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:targetApi="p" />

                <LinearLayout
                    android:id="@+id/btnPaste"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_home_paste"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_paste" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/manrope_semibold"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/paste"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvCharCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/manrope_medium"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/home_text_muted"
                    android:textSize="11sp"
                    tools:text="0 / 5000" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <!-- Feature tiles. -->
            <LinearLayout
                android:id="@+id/llActionTiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/clEnableKeyboardBanner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_tile"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    android:padding="13dp"
                    tools:targetApi="p">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_home_icon_tile_blue">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_keyboard" />
                    </FrameLayout>

                    <TextView
                        style="@style/HomeText.TileTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:maxLines="2"
                        android:text="@string/home_translate_keyboard" />

                    <TextView
                        style="@style/HomeText.TileSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:maxLines="2"
                        android:text="@string/home_translate_keyboard_desc" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/clFunWords"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_tile"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    android:padding="13dp"
                    tools:targetApi="p">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_home_icon_tile_purple">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_bulb" />
                    </FrameLayout>

                    <TextView
                        style="@style/HomeText.TileTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:maxLines="2"
                        android:text="@string/fun_words" />

                    <TextView
                        style="@style/HomeText.TileSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:maxLines="2"
                        android:text="@string/home_fun_words_desc" />
                </LinearLayout>
            </LinearLayout>

            <!-- Learn a language (translator/pro/learn). -->
            <include
                android:id="@+id/learnCard"
                layout="@layout/learn_home_card" />

            <!-- Recent translations. -->
            <LinearLayout
                android:id="@+id/clHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp">

                    <TextView
                        style="@style/HomeText.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent" />

                    <TextView
                        android:id="@+id/tvViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="-6dp"
                        android:background="@drawable/bg_home_text_button"
                        android:fontFamily="@font/manrope_semibold"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:text="@string/view_all"
                        android:textColor="@color/home_accent"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="3"
                    tools:listitem="@layout/history_item_home" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
