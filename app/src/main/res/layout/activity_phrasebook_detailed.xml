<?xml version="1.0" encoding="utf-8"?>
<!-- Phrase details. Figma TranslatorProZyro "Phrasebook detail" (6:1286): back + category name, language
     card, the category's phrase groups as expandable cards (list_group / list_item), native ad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    tools:context="org.dslul.openboard.translator.pro.PhrasebookDetailedActivity">

    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Ui.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/ui_tabs_back"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:srcCompat="@drawable/ic_ui_arrow_left"
            app:tint="@color/home_text_primary"
            tools:targetApi="p" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/HomeText.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/app_name"
            tools:text="At the Restaurant" />
    </LinearLayout>

    <!-- Language card: the Home language bar inside a small card. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llLanguageSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_ui_card_r16"
        android:elevation="2dp"
        android:outlineSpotShadowColor="@color/home_shadow"
        android:padding="8dp"
        android:transitionName="anim_ll_languages"
        tools:targetApi="p">

        <LinearLayout
            android:id="@+id/llLanguageFrom"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_home_lang_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/ivSwitchLanguages"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/flagFrom"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/us_flag"
                app:shapeAppearanceOverlay="@style/roundedCorners" />

            <TextView
                android:id="@+id/tvLanguageFrom"
                style="@style/HomeText.Language"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/english" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_chevron_down" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivSwitchLanguages"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_home_swap"
            android:contentDescription="@string/swap_languages"
            android:padding="10.5dp"
            android:src="@drawable/ic_home_swap"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/llLanguageTo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_home_lang_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@id/ivSwitchLanguages"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_chevron_down" />

            <TextView
                android:id="@+id/tvLanguageTo"
                style="@style/HomeText.Language"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                tools:text="Spanish" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/flagTo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/by_flag"
                app:shapeAppearanceOverlay="@style/roundedCorners" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Groups and their phrases draw their own card pieces; each group row adds the 10dp gap above it. -->
    <ExpandableListView
        android:id="@+id/expandableListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:childDivider="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:groupIndicator="@null"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:paddingBottom="12dp"
        android:scrollbarStyle="outsideOverlay" />

    <FrameLayout
        android:id="@+id/nativeAdFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_200sdp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ui_card_r16"
        android:elevation="2dp"
        android:outlineSpotShadowColor="@color/home_shadow"
        android:visibility="gone"
        tools:targetApi="p" />
</LinearLayout>
