<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard dock native ad: icon, headline, rating + body, Install, AD badge.
     Figma: TranslatorPro, "Home — Redesign" (2035:892). Bound by AdmobNativeAds.showNativeAd. -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_ad_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="11dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/HomeAdIconShape" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/home_text_primary"
                android:textSize="13sp"
                tools:text="Lingua: Learn Languages" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ad_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/manrope_bold"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="★ 4.8"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope_regular"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="11sp"
                    tools:text="Education · Free" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="11dp"
            android:background="@drawable/bg_home_ad_install"
            android:fontFamily="@font/manrope_bold"
            android:includeFontPadding="false"
            android:maxWidth="110dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="15dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/home_accent"
            android:textSize="12sp"
            tools:text="Install" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:background="@drawable/bg_home_ad_badge"
            android:fontFamily="@font/manrope_extrabold"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/ad_label"
            android:textAllCaps="true"
            android:textColor="@color/home_ad_badge_text"
            android:textSize="9sp" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
