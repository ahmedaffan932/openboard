<?xml version="1.0" encoding="utf-8"?>
<!-- End of a lesson (Figma "Lesson · Complete"): flame halo, title, XP / accuracy / time, streak card
     with this week's days, Continue, small native ad. Also used for practice and test-out results. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnResultClose"
            style="@style/Widget.Ui.IconButton"
            android:layout_gravity="end"
            android:contentDescription="@string/learn_close"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:srcCompat="@drawable/ic_ui_x"
            app:tint="@color/home_text_primary"
            tools:targetApi="p" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/flHalo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_ui_circle_orange">

                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ui_circle_surface"
                    android:elevation="2dp"
                    android:outlineSpotShadowColor="@color/home_shadow"
                    tools:targetApi="p">

                    <ImageView
                        android:id="@+id/ivResultIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_ui_flame"
                        app:tint="@color/home_orange" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvResultTitle"
                style="@style/HomeText.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                tools:text="Lesson complete!" />

            <TextView
                android:id="@+id/tvResultDesc"
                style="@style/HomeText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/home_text_secondary"
                tools:text="You learned 6 new words in Spanish." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                tools:targetApi="p">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatXp"
                        style="@style/HomeText.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/home_accent"
                        tools:text="+15" />

                    <TextView
                        style="@style/HomeText.CaptionMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/learn_xp_earned"
                        android:textColor="@color/home_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatAccuracy"
                        style="@style/HomeText.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/home_success"
                        tools:text="92%" />

                    <TextView
                        style="@style/HomeText.CaptionMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/learn_accuracy"
                        android:textColor="@color/home_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatTime"
                        style="@style/HomeText.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/home_purple"
                        tools:text="3:12" />

                    <TextView
                        style="@style/HomeText.CaptionMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/learn_time"
                        android:textColor="@color/home_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llStreakCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ui_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/home_shadow"
                android:padding="16dp"
                tools:targetApi="p">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ui_circle_orange">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_ui_flame"
                            app:tint="@color/home_orange" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStreakTitle"
                            style="@style/HomeText.CardLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="4 day streak" />

                        <TextView
                            android:id="@+id/tvStreakGoal"
                            style="@style/HomeText.CaptionMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/home_success"
                            tools:text="Daily goal reached · 2 of 2 lessons" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnResultContinue"
        style="@style/Widget.Ui.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/learn_continue"
        tools:targetApi="p" />

    <FrameLayout
        android:id="@+id/flResultAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
