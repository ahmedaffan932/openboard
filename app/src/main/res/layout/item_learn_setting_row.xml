<?xml version="1.0" encoding="utf-8"?>
<!-- A Learn settings row (Figma "Learn · Settings"): icon tile, title, subtitle, then a value with a
     chevron or a switch. LearnSettingsActivity fills each include. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ui_row_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/flIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_ui_tile_accent">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/home_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/HomeText.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Daily reminder" />

        <TextView
            android:id="@+id/tvSubtitle"
            style="@style/HomeText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            tools:text="Keeps your streak alive"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValue"
        style="@style/HomeText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/home_accent"
        android:visibility="gone"
        tools:text="8:00 PM" />

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_ui_chevron_right"
        app:tint="@color/home_text_muted" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swValue"
        style="@style/Widget.Ui.Switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:visibility="gone" />
</LinearLayout>
