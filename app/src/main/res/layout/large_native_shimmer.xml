<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder for the large native ads (admob_native_hctr / admob_native_layout_lctr,
     300dp slot): header blocks, body line, a media block taking the rest, a full-width CTA block.
     The card is the shimmer layout's own background, so only the blocks shimmer. -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerViewThe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ui_card"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    app:shimmer_auto_start="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/view"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ui_sys_shimmer_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:id="@+id/view1"
                    android:layout_width="150dp"
                    android:layout_height="12dp"
                    android:background="@drawable/ui_sys_shimmer_block" />

                <View
                    android:id="@+id/view2"
                    android:layout_width="90dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ui_sys_shimmer_block" />
            </LinearLayout>

            <View
                android:id="@+id/view3"
                android:layout_width="22dp"
                android:layout_height="14dp"
                android:layout_gravity="top"
                android:layout_marginStart="8dp"
                android:background="@drawable/ui_sys_shimmer_block" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/ui_sys_shimmer_block" />

        <View
            android:id="@+id/media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/ui_sys_shimmer_icon" />

        <View
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ui_sys_shimmer_pill" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
