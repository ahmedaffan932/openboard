<?xml version="1.0" encoding="utf-8"?>
<!-- Camera permission. Figma TranslatorProZyro "Camera permission" (7:1359): back + title, camera
     illustration (accent halo, surface circle, camera icon), title, explanation, Allow access,
     Not now, native ad at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    tools:context="org.dslul.openboard.translator.pro.CameraPermissionActivity">

    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Widget.Ui.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/ui_tabs_back"
            android:outlineSpotShadowColor="@color/home_shadow"
            app:srcCompat="@drawable/ic_ui_arrow_left"
            app:tint="@color/home_text_primary"
            tools:targetApi="p" />

        <TextView
            style="@style/HomeText.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/camera_permission" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_ui_circle_accent">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ui_circle_surface_plain"
                    android:elevation="4dp"
                    android:outlineSpotShadowColor="@color/home_shadow_blue"
                    tools:targetApi="p">

                    <ImageView
                        android:id="@+id/ivMain"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_ui_camera"
                        app:tint="@color/home_accent" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                style="@style/HomeText.Screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/ui_tabs_camera_access_title" />

            <TextView
                android:id="@+id/tvDescription"
                style="@style/HomeText.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/camera_permission_description" />

            <TextView
                android:id="@+id/btnAllow"
                style="@style/Widget.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/allow_access" />

            <TextView
                android:id="@+id/btnNotNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_home_text_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope_semibold"
                android:includeFontPadding="false"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/not_now"
                android:textColor="@color/home_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/nativeAdFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_220sdp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ui_card_r16"
        android:elevation="2dp"
        android:outlineSpotShadowColor="@color/home_shadow"
        android:visibility="gone"
        tools:targetApi="p" />
</LinearLayout>
